# .env.example — committed template (NEVER put real values here).
# Copy to .env (gitignored, chmod 600) and fill per-machine.
# Only declare keys the kernel actually reads.

# Telegram notifications (libs/notif)
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=

# Package registries (publishing)
NPM_TOKEN=
UV_PUBLISH_TOKEN=

# Container registry
DOCKER_PAT=

# Cloudflare (k-cloudflare)
CF_API_TOKEN=

# Hugging Face (model downloads)
HF_TOKEN=
