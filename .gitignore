# QMD vector database (local, not versioned)
lancedb/

# SQLite indexes
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Editor backup files (nvim, etc.)
*~

# OS artifacts
.DS_Store

# Python cache artifacts
__pycache__/
*.pyc

# Vendor plugin trees (local install only; not kernel source)
plugins/*
!plugins/kpihx-orchestra
!plugins/kpihx-orchestra/*

# Submodule build/runtime artifacts (never versioned — reinstallable)
skills/k-opencode/scripts/plugins/**/vendor/
skills/k-opencode/scripts/plugins/**/node_modules/
skills/k-opencode/scripts/plugins/**/dist/

# Ephemeral Data Cloud skill manifest
skills/.datacloud_skills_manifest
hermes/

# Secrets — never commit
.env

# Runtime logs (auto-generated)
logs/

# Temporary storage — merged-away originals, old backups (cleaned by k-optim)
tmp/
