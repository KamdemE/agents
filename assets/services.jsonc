{
  // ============================================================================
  // services.jsonc — the single source of truth for .agents-owned systemd units
  // ============================================================================
  // Single-machine fork: register here ONLY services actually deployed on THIS
  // machine. Nothing is pre-registered — add entries as you deploy units.
  //
  // WHO USES IT:
  //   - scripts/services/check-services.sh    (verify each service)
  //   - scripts/services/reload-services.sh   (reload the machine's services)
  //
  // KEY = appellation, e.g. "clean-service", "clean-timer".
  //
  // FIELDS per service:
  //   unit         : REAL systemd unit filename (e.g. "clean.service")
  //   type         : "user" or "system" (systemd scope)
  //   path         : canonical location in $HOME/.agents (source of truth)
  //   skill        : owning k-* skill
  //   infras       : always ["*"] on this fork
  //   expect-active: true → the service must be ACTIVE (not just present)
  //   deployment   : "symlink" (default, needs exactly one links.jsonc entry
  //                  for the unit) or "copy" (unit copied to /etc, no link)
  //
  // Template (uncomment + adapt when deploying):
  //   "my-service": {
  //     "unit": "my.service",
  //     "type": "user",
  //     "path": "$HOME/.agents/skills/k-example/assets/my.service",
  //     "skill": "k-example",
  //     "infras": ["*"],
  //     "expect-active": true
  //   },
  // ============================================================================

  "services": {
  }
}
