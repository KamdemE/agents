{
  // ============================================================================
  // services.jsonc — the single source of truth for .agents-owned systemd units
  // ============================================================================
  // WHY JSONC: comments allowed → self-documenting. JSONC is the KπX standard
  // for config files (see kpihx-labs → Config Standard). .env holds secrets.
  //
  // WHO USES IT:
  //   - scripts/services/check-services.sh    (verify each service, max verbosity)
  //   - scripts/services/reload-services.sh   (reload the current infra's services)
  //   - scripts/links/lib.sh                  (shared JSONC loader via libs/)
  //
  // APPROACH (2026-08-14): DIRECT list grouped by owning skill (each block is a
  // `// --- <skill> ---` comment). No common-*/optional grouping.
  //
  // KEY = APPELLATION (NOT the unit file name):
  //   - default  : <name>-<type>        e.g. "clean-service"  (type = service|timer|socket|...)
  //   - infra    : append -<infra> ONLY IF the owning skill IS the infra skill
  //                (i.e. k-ubuntu→-ubuntu, k-pve→-pve, k-dockerhost→-dockerhost).
  //                Generic/tool skills (k-opencode, k-hermes, k-dxo, k-rclone, k-ollama)
  //                do NOT get an infra suffix — their services are shared.
  //   - example  : clean.service on ubuntu → key "clean-service-ubuntu"
  //
  // "unit" PARAM = the REAL systemd unit filename used on the machine
  //   (e.g. "clean.service"). It is a PARAM, not the key, because the same logical
  //   service may be deployed under different unit names per infra in the future
  //   (e.g. a future clean-service-pve). The machine still calls it by "unit".
  //
  // FIELDS per service:
  //   unit         : REAL systemd unit filename (e.g. "clean.service")  ← the actual name
  //   type         : "user" or "system" (systemd scope)
  //   path         : canonical location in $HOME/.agents (source of truth)
  //   skill        : owning k-* skill
  //   infras       : array of infra names that need this service, or ["*"]
  //                  ("*" = ALL infra = the new MANDATORY)
  //   expect-active: true → the service must be ACTIVE (not just present) + healthy
  //
  // A service not in the current infra's list is simply skipped. The current infra
  // comes from tailscale (see infras_skills.jsonc). Tailscale is the backbone.
  // ============================================================================

  "services": {

    // --- k-tailscale -----------------------------------------------------------
    // 2026-08-24: tailscaled.service DE-LINKED from .agents per KπX order (stock
    // Tailscale-managed unit, zero customization → /etc only, Tailscale governs it).
    // Registry entry removed; service still expected active everywhere (mesh backbone).

    // --- k-ubuntu (infra skill for kpihx-ubuntu) --------------------------------
    // owning skill IS infra skill → -ubuntu suffix; required only on kpihx-ubuntu
    "clean-service-ubuntu": {
      "unit": "clean.service",
      "type": "system",
      "path": "$HOME/.agents/skills/k-ubuntu/assets/clean/clean.service",
      "skill": "k-ubuntu",
      "infras": ["kpihx-ubuntu"],
      "expect-active": false
    },
    "clean-timer-ubuntu": {
      "unit": "clean.timer",
      "type": "system",
      "path": "$HOME/.agents/skills/k-ubuntu/assets/clean/clean.timer",
      "skill": "k-ubuntu",
      "infras": ["kpihx-ubuntu"],
      "expect-active": true
    },
    "backup-restore-service-ubuntu": {
      "unit": "backup-restore.service",
      "type": "system",
      "path": "$HOME/.agents/skills/k-ubuntu/assets/backup_restore/backup-restore.service",
      "skill": "k-ubuntu",
      "infras": ["kpihx-ubuntu"],
      "expect-active": false
    },
    "backup-restore-timer-ubuntu": {
      "unit": "backup-restore.timer",
      "type": "system",
      "path": "$HOME/.agents/skills/k-ubuntu/assets/backup_restore/backup-restore.timer",
      "skill": "k-ubuntu",
      "infras": ["kpihx-ubuntu"],
      "expect-active": true
    },
    "pve-backup-service-ubuntu": {
      "unit": "pve-backup.service",
      "type": "system",
      "path": "$HOME/.agents/skills/k-ubuntu/assets/backup_restore_pve/pve-backup.service",
      "skill": "k-ubuntu",
      "infras": ["kpihx-ubuntu"],
      "expect-active": false
    },
    "pve-backup-timer-ubuntu": {
      "unit": "pve-backup.timer",
      "type": "system",
      "path": "$HOME/.agents/skills/k-ubuntu/assets/backup_restore_pve/pve-backup.timer",
      "skill": "k-ubuntu",
      "infras": ["kpihx-ubuntu"],
      "expect-active": true
    },

    // --- k-ollama DEACTIVATED 2026-09-01 (replaced by k-openvino) → skills/deactive/ ---

    // --- k-hermes (generic, NOT infra) → no suffix ------------------------------
    "hermes-gateway-service": {
      "unit": "hermes-gateway.service",
      "type": "user",
      "path": "$HOME/.agents/skills/k-hermes/assets/hermes-gateway.service",
      "skill": "k-hermes",
      "infras": ["kpihx-ubuntu"],
      "expect-active": true
    },

    // --- k-openclaw (generic, NOT infra) → no suffix -----------------------------
    "openclaw-gateway-service": {
      "unit": "openclaw-gateway.service",
      "type": "user",
      "path": "$HOME/.agents/skills/k-openclaw/assets/openclaw-gateway.service",
      "skill": "k-openclaw",
      "infras": ["kpihx-ubuntu"],
      "expect-active": true
    },

    // --- k-opencode (generic, NOT infra) → no suffix ----------------------------
    "opencode-web-shim-service": {
      "unit": "opencode-web-shim.service",
      "type": "user",
      "path": "$HOME/.agents/skills/k-opencode/assets/opencode-web-shim.service",
      "skill": "k-opencode",
      "infras": ["kpihx-ubuntu"],
      "expect-active": true
    },

    "opencode-web-service": {
      "unit": "opencode-web.service",
      "type": "user",
      "path": "$HOME/.agents/skills/k-opencode/assets/opencode-web.service",
      "skill": "k-opencode",
      "infras": ["kpihx-ubuntu"],
      "expect-active": true
    },
    "opencode-lens-service": {
      "unit": "opencode-lens.service",
      "type": "user",
      "path": "$HOME/.agents/skills/k-opencode/assets/opencode-lens.service",
      "skill": "k-opencode",
      "infras": ["kpihx-ubuntu"],
      "expect-active": true
    },
    "opencode-go-proxy-service": {
      "unit": "opencode-go-proxy.service",
      "type": "user",
      "path": "$HOME/.agents/skills/k-opencode/assets/opencode-go-proxy.service",
      "skill": "k-opencode",
      "infras": ["kpihx-ubuntu"],
      "expect-active": true
    },

    // --- k-rclone (generic, NOT infra) → no suffix ------------------------------
    "rclone-gdrive-service": {
      "unit": "rclone-gdrive.service",
      "type": "user",
      "path": "$HOME/.agents/skills/k-rclone/assets/rclone-gdrive.service",
      "skill": "k-rclone",
      "infras": ["kpihx-ubuntu"],
      "expect-active": true
    },
    "rclone-gdrive-x-service": {
      "unit": "rclone-gdrive-x.service",
      "type": "user",
      "path": "$HOME/.agents/skills/k-rclone/assets/rclone-gdrive-x.service",
      "skill": "k-rclone",
      "infras": ["kpihx-ubuntu"],
      "expect-active": true
    },

    // --- k-dxo DEACTIVATED 2026-09-01 (DxO internship ended) → skills/deactive/ ---

    // --- k-pve (infra skill for kpihx-pve) → -pve suffix --------------------------
    // Critical PVE units are deliberately copied into /etc, not symlinked.
    "boot-notify-service-pve": {
      "unit": "boot-notify.service",
      "type": "system",
      "path": "$HOME/.agents/skills/k-pve/assets/network/boot-notify.service",
      "skill": "k-pve",
      "infras": ["kpihx-pve"],
      "deployment": "copy",
      "expect-active": true
    },
    "watchdog-service-pve": {
      "unit": "watchdog.service",
      "type": "system",
      "path": "$HOME/.agents/skills/k-pve/assets/network/watchdog.service",
      "skill": "k-pve",
      "infras": ["kpihx-pve"],
      "deployment": "copy",
      "expect-active": true
    },
    "watchdog-timer-pve": {
      "unit": "watchdog.timer",
      "type": "system",
      "path": "$HOME/.agents/skills/k-pve/assets/network/watchdog.timer",
      "skill": "k-pve",
      "infras": ["kpihx-pve"],
      "deployment": "copy",
      "expect-active": true
    },

    // --- k-dockerhost (infra skill for kpihx-dockerhost) → -dockerhost suffix -----
    "vault-backup-service-dockerhost": {
      "unit": "vault-backup.service",
      "type": "system",
      "path": "$HOME/.agents/skills/k-dockerhost/scripts/vault/systemd/vault-backup.service",
      "skill": "k-dockerhost",
      "infras": ["kpihx-dockerhost"],
      "expect-active": true
    },
    "vault-backup-timer-dockerhost": {
      "unit": "vault-backup.timer",
      "type": "system",
      "path": "$HOME/.agents/skills/k-dockerhost/scripts/vault/systemd/vault-backup.timer",
      "skill": "k-dockerhost",
      "infras": ["kpihx-dockerhost"],
      "expect-active": true
    }
  }
}
