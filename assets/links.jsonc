{
  // ============================================================================
  // links.jsonc — the single source of truth for .agents-owned symlinks
  // ============================================================================
  // Single-machine fork: entries use ["*"] (this machine). Dormant platform
  // links (phone, windows) keep their named scope so they never apply here
  // but stay registered for machines that need them.
  //
  // WHO USES IT:
  //   - scripts/links/set-links.sh   (create/recreate every registered symlink)
  //   - scripts/links/check-links.sh (verify none is broken/reversed)
  //
  // FIELDS per link:
  //   source : the OS-location symlink (e.g. $HOME/.config/opencode/...)
  //   target : the canonical $HOME/.agents/... source of truth
  //   skill  : owning k-* skill
  //   infras : always ["*"] on this fork
  //   allow-reversed : OPTIONAL boolean (default false). Tolerates a resolved
  //            target outside $HOME/.agents (reported, not a failure).
  // ============================================================================

  "links": {

    // --- k-ai ---
    "k-piper": {"source": "$HOME/.local/bin/k-piper", "target": "$HOME/.agents/skills/k-ai/scripts/k-piper.sh", "skill": "k-ai", "infras": ["*"]},
    "k-translate": {"source": "$HOME/.local/bin/k-translate", "target": "$HOME/.agents/skills/k-ai/scripts/k-translate.sh", "skill": "k-ai", "infras": ["*"]},
    "k-whisper": {"source": "$HOME/.local/bin/k-whisper", "target": "$HOME/.agents/skills/k-ai/scripts/k-whisper.sh", "skill": "k-ai", "infras": ["*"]},

    // --- k-clis ---
    "curls": {"source": "$HOME/.local/bin/curls", "target": "$HOME/.agents/skills/k-clis/scripts/curls.sh", "skill": "k-clis", "infras": ["*"]},
    "rm": {"source": "$HOME/.local/bin/rm", "target": "$HOME/.agents/skills/k-clis/assets/rm", "skill": "k-clis", "infras": ["*"]},

    // --- k-code ---
    "code-chatLanguageModels": {"source": "$HOME/.config/Code/User/chatLanguageModels.json", "target": "$HOME/.agents/skills/k-code/assets/chatLanguageModels.json", "skill": "k-code", "infras": ["*"]},
    "code-keybindings": {"source": "$HOME/.config/Code/User/keybindings.json", "target": "$HOME/.agents/skills/k-code/assets/keybindings.json", "skill": "k-code", "infras": ["*"]},
    "code-mcp": {"source": "$HOME/.config/Code/User/mcp.json", "target": "$HOME/.agents/skills/k-code/assets/mcp.json", "skill": "k-code", "infras": ["*"]},
    "code-profile-cpp": {"source": "$HOME/.config/Code/User/profiles/cpp.code-profile", "target": "$HOME/.agents/skills/k-code/references/profiles/cpp.code-profile", "skill": "k-code", "infras": ["*"]},
    "code-profile-general": {"source": "$HOME/.config/Code/User/profiles/general.code-profile", "target": "$HOME/.agents/skills/k-code/references/profiles/general.code-profile", "skill": "k-code", "infras": ["*"]},
    "code-profile-java": {"source": "$HOME/.config/Code/User/profiles/java.code-profile", "target": "$HOME/.agents/skills/k-code/references/profiles/java.code-profile", "skill": "k-code", "infras": ["*"]},
    "code-profile-latex": {"source": "$HOME/.config/Code/User/profiles/latex.code-profile", "target": "$HOME/.agents/skills/k-code/references/profiles/latex.code-profile", "skill": "k-code", "infras": ["*"]},
    "code-settings": {"source": "$HOME/.config/Code/User/settings.json", "target": "$HOME/.agents/skills/k-code/assets/settings.json", "skill": "k-code", "infras": ["*"]},
    "cursor-chatLanguageModels": {"source": "$HOME/.config/Cursor/User/chatLanguageModels.json", "target": "$HOME/.agents/skills/k-code/assets/chatLanguageModels.json", "skill": "k-code", "infras": ["*"]},
    "cursor-keybindings": {"source": "$HOME/.config/Cursor/User/keybindings.json", "target": "$HOME/.agents/skills/k-code/assets/keybindings.json", "skill": "k-code", "infras": ["*"]},
    "cursor-mcp": {"source": "$HOME/.config/Cursor/User/mcp.json", "target": "$HOME/.agents/skills/k-code/assets/mcp.json", "skill": "k-code", "infras": ["*"]},
    "cursor-settings": {"source": "$HOME/.config/Cursor/User/settings.json", "target": "$HOME/.agents/skills/k-code/assets/settings.json", "skill": "k-code", "infras": ["*"]},

    // --- k-git ---
    "agents-post-commit": {"source": "$HOME/.agents/.git/hooks/post-commit", "target": "$HOME/.agents/scripts/git/hooks/post-commit.sh", "skill": "k-git", "infras": ["*"]},
    "git-hooks-commit-msg": {"source": "$HOME/.config/git/hooks/commit-msg", "target": "$HOME/.agents/skills/k-git/scripts/git-hook-passthrough.sh", "skill": "k-git", "infras": ["*"]},
    "git-hooks-post-checkout": {"source": "$HOME/.config/git/hooks/post-checkout", "target": "$HOME/.agents/skills/k-git/scripts/git-hook-passthrough.sh", "skill": "k-git", "infras": ["*"]},
    "git-hooks-post-merge": {"source": "$HOME/.config/git/hooks/post-merge", "target": "$HOME/.agents/skills/k-git/scripts/git-hook-passthrough.sh", "skill": "k-git", "infras": ["*"]},
    "git-hooks-post-rewrite": {"source": "$HOME/.config/git/hooks/post-rewrite", "target": "$HOME/.agents/skills/k-git/scripts/git-hook-passthrough.sh", "skill": "k-git", "infras": ["*"]},
    "git-hooks-pre-applypatch": {"source": "$HOME/.config/git/hooks/pre-applypatch", "target": "$HOME/.agents/skills/k-git/scripts/git-hook-passthrough.sh", "skill": "k-git", "infras": ["*"]},
    "git-hooks-pre-commit": {"source": "$HOME/.config/git/hooks/pre-commit", "target": "$HOME/.agents/skills/k-git/scripts/git-hook-passthrough.sh", "skill": "k-git", "infras": ["*"]},
    "git-hooks-pre-push": {"source": "$HOME/.config/git/hooks/pre-push", "target": "$HOME/.agents/skills/k-git/scripts/git-hook-passthrough.sh", "skill": "k-git", "infras": ["*"]},
    "git-hooks-pre-rebase": {"source": "$HOME/.config/git/hooks/pre-rebase", "target": "$HOME/.agents/skills/k-git/scripts/git-hook-passthrough.sh", "skill": "k-git", "infras": ["*"]},
    "git-hooks-prepare-commit-msg": {"source": "$HOME/.config/git/hooks/prepare-commit-msg", "target": "$HOME/.agents/skills/k-git/scripts/git-hook-passthrough.sh", "skill": "k-git", "infras": ["*"]},
    "git-ignore-global": {"source": "$HOME/.config/git/ignore", "target": "$HOME/.agents/skills/k-git/assets/git-ignore-global", "skill": "k-git", "infras": ["*"]},
    "gitconfig": {"source": "$HOME/.gitconfig", "target": "$HOME/.agents/skills/k-git/assets/gitconfig", "skill": "k-git", "infras": ["*"]},


    // --- k-loom ---
    "git-hooks-post-commit": {"source": "$HOME/.config/git/hooks/post-commit", "target": "$HOME/.agents/skills/k-loom/assets/git-post-commit.sh", "skill": "k-loom", "infras": ["*"]},


    // --- k-nvim ---
    "nvim-init": {"source": "$HOME/.config/nvim/init.lua", "target": "$HOME/.agents/skills/k-nvim/assets/init.lua", "skill": "k-nvim", "infras": ["*"]},
    "nvim-kpihx": {"source": "$HOME/.config/nvim/lua/kpihx", "target": "$HOME/.agents/skills/k-nvim/assets/lua/kpihx", "skill": "k-nvim", "infras": ["*"]},
    "nvim-lazy-lock": {"source": "$HOME/.config/nvim/lazy-lock.json", "target": "$HOME/.agents/skills/k-nvim/assets/lazy-lock.json", "skill": "k-nvim", "infras": ["*"]},
    "nvim-uv-nvim-pyproject": {"source": "$HOME/.local/share/nvim/uv-nvim/pyproject.toml", "target": "$HOME/.agents/skills/k-nvim/assets/uv-nvim/pyproject.toml", "skill": "k-nvim", "infras": ["*"]},
    "vimrc": {"source": "$HOME/.vimrc", "target": "$HOME/.agents/skills/k-nvim/assets/vimrc", "skill": "k-nvim", "infras": ["*"]},


    // --- k-opencode ---
    "opencode-AGENTS-md": {"source": "$HOME/.config/opencode/AGENTS.md", "target": "$HOME/.agents/AGENTS.md", "skill": "k-opencode", "infras": ["*"]},
    "opencode-agents": {"source": "$HOME/.config/opencode/agents", "target": "$HOME/.agents/agents", "skill": "k-opencode", "infras": ["*"]},
    "opencode-context-command": {"source": "$HOME/.config/opencode/commands/context.md", "target": "$HOME/.agents/skills/k-opencode/assets/plugins/context/context.md", "skill": "k-opencode", "infras": ["*"]},
    "opencode-opencode-jsonc": {"source": "$HOME/.config/opencode/opencode.jsonc", "target": "$HOME/.agents/skills/k-opencode/assets/opencode.jsonc", "skill": "k-opencode", "infras": ["*"]},
    "opencode-tui-json": {"source": "$HOME/.config/opencode/tui.json", "target": "$HOME/.agents/skills/k-opencode/assets/tui.json", "skill": "k-opencode", "infras": ["*"]},

    // --- k-presentation ---
    "presentation-Makefile": {"source": "$HOME/.agents/skills/k-presentation/assets/Makefile", "target": "$HOME/.agents/skills/k-tex/assets/Makefile", "skill": "k-presentation", "infras": ["*"]},
    "presentation-check-dashes": {"source": "$HOME/.agents/skills/k-presentation/scripts/check-dashes.sh", "target": "$HOME/.agents/skills/k-tex/scripts/check-dashes.sh", "skill": "k-presentation", "infras": ["*"]},

    // --- k-phones (dormant here — phone scope never matches this machine) ---
    "kshrc-phones": {"source": "$HOME/.kshrc", "target": "$HOME/.agents/skills/k-phones/assets/kshrc", "skill": "k-phones", "infras": ["phone"]},
    // --- k-windows (dormant here — windows scope never matches this machine) ---
    "kshrc-windows": {"source": "$HOME/.kshrc", "target": "$HOME/.agents/skills/k-windows/assets/kshrc", "skill": "k-windows", "infras": ["windows"]},
    // --- k-qmd ---
    "qmdr": {"source": "$HOME/.local/bin/qmdr", "target": "$HOME/.agents/skills/k-qmd/scripts/qmdr", "skill": "k-qmd", "infras": ["*"]},

    // --- k-ssh ---
    "gpg-agent-conf": {"source": "$HOME/.gnupg/gpg-agent.conf", "target": "$HOME/.agents/skills/k-ssh/assets/gpg-agent.conf", "skill": "k-ssh", "infras": ["*"]},

    // --- k-tmux ---
    "tmux-conf": {"source": "$HOME/.tmux.conf", "target": "$HOME/.agents/skills/k-tmux/assets/tmux.conf", "skill": "k-tmux", "infras": ["*"]},
    "tmux-continuum-save": {"source": "$HOME/.tmux/plugins/tmux-continuum/scripts/continuum_save.sh", "target": "$HOME/.agents/skills/k-tmux/assets/tmux-continuum-save.sh", "skill": "k-tmux", "infras": ["*"]},
    "tmux-init": {"source": "$HOME/.local/bin/tmux-init", "target": "$HOME/.agents/skills/k-tmux/assets/tmux-init.sh", "skill": "k-tmux", "infras": ["*"]},
    "tmux-resurrect-restore": {"source": "$HOME/.tmux/plugins/tmux-resurrect/scripts/restore.sh", "target": "$HOME/.agents/skills/k-tmux/assets/tmux-resurrect-restore.sh", "skill": "k-tmux", "infras": ["*"]},
    "tmux-resurrect-save": {"source": "$HOME/.tmux/plugins/tmux-resurrect/scripts/save.sh", "target": "$HOME/.agents/skills/k-tmux/assets/tmux-resurrect-save.sh", "skill": "k-tmux", "infras": ["*"]},

    // --- k-ubuntu ---
    "ksh-ubuntu": {"source": "$HOME/.local/bin/ksh", "target": "$HOME/.agents/skills/k-ubuntu/scripts/ksh.sh", "skill": "k-ubuntu", "infras": ["*"]},
    "kshrc-ubuntu": {"source": "$HOME/.kshrc", "target": "$HOME/.agents/skills/k-ubuntu/assets/kshrc", "skill": "k-ubuntu", "infras": ["*"]},
    "mimeapps-ubuntu": {"source": "$HOME/.config/mimeapps.list", "target": "$HOME/.agents/skills/k-ubuntu/assets/mimeapps.list", "skill": "k-ubuntu", "infras": ["*"]},

    // --- k-zsh ---
    "bashrc": {"source": "$HOME/.bashrc", "target": "$HOME/.agents/skills/k-zsh/assets/bashrc", "skill": "k-zsh", "infras": ["*"]},
    "profile": {"source": "$HOME/.profile", "target": "$HOME/.agents/skills/k-zsh/assets/profile", "skill": "k-zsh", "infras": ["*"]},
    "zprofile": {"source": "$HOME/.zprofile", "target": "$HOME/.agents/skills/k-zsh/assets/zprofile", "skill": "k-zsh", "infras": ["*"]},
    "zshenv": {"source": "$HOME/.zshenv", "target": "$HOME/.agents/skills/k-zsh/assets/zshenv", "skill": "k-zsh", "infras": ["*"]},
    "zshrc": {"source": "$HOME/.zshrc", "target": "$HOME/.agents/skills/k-zsh/assets/zshrc", "skill": "k-zsh", "infras": ["*"]}
  },

  // --- Declarative completeness-audit surface ---
  "audit": {
    "sources": [
      { "path": "$HOME", "max-depth": 1 },
      { "path": "$HOME/.config", "max-depth": 5 },
      { "path": "$HOME/.local", "max-depth": 5 },
      { "path": "/etc", "max-depth": 5 }
    ],
    "exclusions": [
      "Gdrive",
      "Trash",
      ".venv",
      "node_modules",
      "models"
    ]
  }
}
