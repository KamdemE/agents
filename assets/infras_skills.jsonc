{
  // infras_skills.jsonc — the single source of truth mapping an infra (device)
  // to its owning k-* skill.
  //
  // WHY JSONC: comments are allowed, so this file is self-documenting. JSONC is
  // the KπX standard for config files (see kpihx-labs → Config Standard).
  //
  // WHO USES IT:
  //   - skills/k-opencode/scripts/plugins/hooks/startup-context.js  (device auto-detect:
  //     tailscale DNSName → infra skill → inject <device-context>).
  //   - scripts/ (check_tailscale.sh, services/*, links/*) resolve the current
  //     infra by reading this map.
  //
  // HOW: key = infra/device name (short Tailscale DNSName or hostname),
  //       value = the k-* skill that owns that infra's operational knowledge.
  // No "infras" wrapper section — this IS the map (flat).
  //
  // NOTE: kpihx-tablet removed 2026-08-14 (not configured).
  // NOTE: kpihx-dockerhost maps to k-dockerhost (renamed from k-pve-dockerhost 2026-07-24).
  // NOTE: blglaptop139-wsl added 2026-08-24 — WSL now runs its own tailscaled as a
  // separate node from the native Windows one (DNSName "blglaptop139-wsl...."), so
  // device auto-detect needs both keys mapped to the same infra skill.

  "kpihx-ubuntu": "k-ubuntu",
  "kpihx-pve": "k-pve",
  "kpihx-pve-debian": "k-pve-debian",
  "kpihx-dockerhost": "k-dockerhost",
  "blglaptop139": "k-blglaptop139",
  "blglaptop139-wsl": "k-blglaptop139",
  "kpihx-s25": "k-phones",
  "deep-pc6": "k-deep-pc6"
}
