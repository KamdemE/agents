{
  "_comment": "KpihX Copilot VS Code hooks. Load through chat.hookFilesLocations in VS Code settings.",
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 $HOME/.agents/hooks/copilot/session_start.py COPILOT",
        "timeout": 10
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "python3 $HOME/.agents/hooks/copilot/user_prompt_submit.py COPILOT",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "python3 $HOME/.agents/hooks/copilot/pre_tool_use.py",
        "timeout": 20
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "python3 $HOME/.agents/hooks/copilot/post_tool_use.py",
        "timeout": 20
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 $HOME/.agents/hooks/copilot/stop.py",
        "timeout": 10
      }
    ]
  }
}
