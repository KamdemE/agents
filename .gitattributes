# ###########################################################################
# KπX .gitattributes — Line endings (executability via index modes, not attrs)
# ###########################################################################
#
# Line endings are normalized to LF for portability.
# Executability is managed by scripts/exec/chmod.sh + scripts/exec/check_exec.sh
# (shebang => executable, no shebang => 644 to avoid Ruff EXE002).
# Do not force 755 here — index modes are the source of truth.
# ###########################################################################

# ── scripts/ (global utilities) ───────────────────────
scripts/**/*.py    text eol=lf
scripts/**/*.sh    text eol=lf
scripts/**/*.zsh   text eol=lf
scripts/**/*.ksh   text eol=lf
scripts/**/*.js    text eol=lf
scripts/**/*.ts    text eol=lf

# ── libs/ (shared libraries) ───────────────────────
libs/**/*.py    text eol=lf
libs/**/*.sh    text eol=lf
libs/**/*.zsh   text eol=lf
libs/**/*.ksh   text eol=lf
libs/**/*.js    text eol=lf
libs/**/*.ts    text eol=lf

# ── skills/**/scripts/ (per-skill scripts — developer entry points) ────────
skills/**/scripts/**/*.py    text eol=lf
skills/**/scripts/**/*.sh    text eol=lf
skills/**/scripts/**/*.zsh   text eol=lf
skills/**/scripts/**/*.ksh   text eol=lf
skills/**/scripts/**/*.js    text eol=lf
skills/**/scripts/**/*.ts    text eol=lf

# ── skills/assets/ (installation scripts, templates) ───────────────────────
skills/**/assets/install.sh    text eol=lf
skills/**/assets/purge.sh      text eol=lf

# ── Binary assets (force binary treatment — never diffed/merged as text) ───
*.pdf   binary
*.pptx  binary
*.docx  binary
*.xlsx  binary
*.onnx  binary
*.bin   binary
