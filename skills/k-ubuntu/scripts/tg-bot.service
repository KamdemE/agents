[Unit]
Description=Telegram Ubuntu Bot (tg-bot.py)
After=network.target
Wants=network.target

[Service]
Type=simple
WorkingDirectory=/home/kpihx/.agents/skills/k-ubuntu/scripts
EnvironmentFile=/home/kpihx/.agents/.env
ExecStart=/usr/bin/python3 /home/kpihx/.agents/skills/k-ubuntu/scripts/tg-bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
