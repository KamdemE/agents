[Unit]
Description=Telegram Ubuntu Bot (ksh)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/kpihx/.agents/skills/k-ubuntu/scripts
EnvironmentFile=/home/kpihx/.bots.env
ExecStart=/usr/bin/python3 /home/kpihx/.agents/skills/k-ubuntu/scripts/bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
