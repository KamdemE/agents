#!/bin/bash
# DxO VPN — launch in tmux session (non-blocking)
# Usage: vpn-dxo          → start VPN in tmux session "vpn-dxo"
#        vpn-dxo stop     → kill VPN session
#        vpn-dxo status   → check status

SESSION="vpn-dxo"

case "${1:-start}" in
  stop)
    tmux kill-session -t "$SESSION" 2>/dev/null && echo "VPN session killed." || echo "No VPN session running."
    ;;
  status)
    if tmux has-session -t "$SESSION" 2>/dev/null; then
      echo "VPN session is running."
      tmux capture-pane -t "$SESSION" -p | tail -5
    else
      echo "No VPN session running."
    fi
    ;;
  start|"")
    if tmux has-session -t "$SESSION" 2>/dev/null; then
      echo "VPN already running. Attaching..."
      tmux attach -t "$SESSION"
      exit 0
    fi
    tmux new-session -d -s "$SESSION" \
      "sudo gpclient --ignore-tls-errors --fix-openssl connect vpn-ext.dxo.com; echo 'VPN disconnected. Press Enter to close.'; read"
    sleep 0.5
    tmux attach -t "$SESSION"
    ;;
  *)
    echo "Usage: vpn-dxo [start|stop|status]"
    ;;
esac
