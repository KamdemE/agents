" KpiX Vim fallback config (SSH/containers/visudo/crontab -e)
" Source: k-nvim/assets/vimrc  ->  ~/.vimrc

set nocompatible
filetype plugin on
syntax on

set number
set tabstop=2
set shiftwidth=2
set expandtab
set smartindent
set ignorecase
set smartcase
set mouse=a
set clipboard=unnamedplus
set scrolloff=8

call plug#begin('~/.vim/plugged')

Plug 'tpope/vim-surround'
Plug 'tpope/vim-commentary'
Plug 'tpope/vim-fugitive'
Plug 'tpope/vim-repeat'

call plug#end()