.DEFAULT_GOAL := help
ZSH_LOGIN     := zsh -lc
BRANCH        := $(shell git rev-parse --abbrev-ref HEAD)

help:  ## Show available targets
	@grep -E '^[a-zA-Z_-]+:.*?##' $(MAKEFILE_LIST) | \
	  awk 'BEGIN {FS = ":.*?## "}; {printf "  %-15s %s\n", $$1, $$2}'

# ── Dev ──────────────────────────────────────────────────────────────────────

link:  ## Install dependencies and link (user)
	@bun install && bun link

unlink:  ## Unlink package
	@bun unlink

test:  ## Run tests (bun test or jest)
	@bun test

lint:  ## Run linter (adjust to eslint/biome/etc.)
	@bun run lint

# ── Build & Publish ───────────────────────────────────────────────────────────

build:  ## Bundle with bun build (adjust entry/outdir as needed)
	@rm -rf dist && bun build src/index.ts --outdir dist --target node

publish: build  ## Publish to npm registry (requires NPM_TOKEN via bw-env)
	@$(ZSH_LOGIN) 'if ! env | grep -q "^NPM_TOKEN="; then \
		echo "NPM_TOKEN missing — run bw-env first"; exit 1; fi; \
	bun publish'
# Note: bun publish uses NPM_TOKEN from env, or BUN_AUTH_TOKEN if set.
# Ensure package.json has "publishConfig": { "access": "public" } for scoped packages.

release: test build publish push  ## Full release: test → build → publish → push

# ── Git ───────────────────────────────────────────────────────────────────────

push:  ## Push current branch to all remotes
	@branch="$$(git branch --show-current)"; \
	for remote in $$(git remote); do \
		echo "==> pushing $$branch to $$remote"; \
		git push "$$remote" "$$branch"; \
	done

push-tags:  ## Push all tags to all remotes
	@for remote in $$(git remote); do git push "$$remote" --tags; done

status:  ## git status --short
	@git status --short

log:  ## Last 10 commits oneline
	@git log --oneline -10
