.DEFAULT_GOAL := help
SHELL := /bin/zsh

PKG_NAME := PROJECT_NAME
VERSION  := $(shell grep -m 1 '"version"' package.json | cut -d: -f2 | tr -d ' ",')

.PHONY: help check smoke bun-link bun-unlink bun-build bun-publish push push-tags status log release

help:  ## Show available targets
	@grep -E '^[a-zA-Z_-]+:.*?##' $(MAKEFILE_LIST) | \
	  awk 'BEGIN {FS = ":.*?## "}; {printf "  %-15s %s\n", $$1, $$2}'

# ── Quality ──────────────────────────────────────────────────────────────────

check: smoke  ## Lint + tests (also run by the global pre-commit gate, see k-git)
	@bun run lint
	@bun test

smoke:  ## Smoke test — adjust to a real CLI/import check for this project
	@bun run src/index.ts --help > /dev/null 2>&1 || (echo "❌ smoke test failed"; exit 1)
	@echo "✅ smoke test passed"

# ── Install / Unlink (bun) ───────────────────────────────────────────────────

bun-link:  ## Install dependencies + link (dev) — CLI always uses the current checkout
	@bun install && bun link

bun-unlink:  ## Unlink the package
	@bun unlink

# ── Build / Publish ──────────────────────────────────────────────────────────

bun-build:  ## Bundle with bun build (adjust entry/outdir as needed)
	@rm -rf dist
	@echo "🏗️  Building $(PKG_NAME) v$(VERSION)..."
	@bun build src/index.ts --outdir dist --target node

bun-publish: bun-build  ## Publish to npm (requires NPM_TOKEN or BUN_AUTH_TOKEN already in the environment)
	@echo "🚀 Publishing v$(VERSION) to npm..."
	@bun publish
# Ensure package.json has "publishConfig": { "access": "public" } for scoped packages.

# ── Git ───────────────────────────────────────────────────────────────────────

push:  ## Push current branch to all remotes
	@branch="$$(git branch --show-current)"; \
	for remote in $$(git remote); do \
		echo "==> pushing $$branch to $$remote"; \
		git push "$$remote" "$$branch"; \
	done

push-tags:  ## Push all tags to all remotes
	@for remote in $$(git remote); do git push "$$remote" --tags; done

status:  ## git status --short
	@git status --short

log:  ## Last 10 commits oneline
	@git log --oneline -10

release: check push bun-publish push-tags  ## Full release: check → push → publish → push tags
