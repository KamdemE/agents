# ── Stage 1: builder ─────────────────────────────────────────────────────────
# uv installs all dependencies into an isolated .venv
# This stage is NOT included in the final image
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

# Copy dep manifests first — docker layer cache: deps only rebuild when these change
COPY pyproject.toml uv.lock README.md ./
# Install dependencies only (not the project itself) — maximizes cache hit
RUN uv sync --frozen --no-dev --no-install-project

# Copy source and install the project entry points into .venv
COPY src ./src
RUN uv sync --frozen --no-dev

# ── Stage 2: runner ───────────────────────────────────────────────────────────
# Only the compiled venv and source are copied — no uv, no pip, no dev tools
FROM python:3.12-slim-bookworm AS runner

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Minimal runtime deps (add curl for healthcheck if needed)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy the built venv from builder — entry points are already compiled inside
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/src /app/src

# Prepend venv bin so entry points defined in pyproject.toml are on PATH
ENV PATH="/app/.venv/bin:$PATH"

# Persistent runtime data (secrets injected at runtime via .env / CI)
VOLUME ["/data"]

EXPOSE 8000

# Replace with your actual entry point (e.g. tick-mcp, your-tool serve-http)
CMD ["your-package", "serve-http"]
