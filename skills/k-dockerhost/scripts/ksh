#!/bin/bash
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

usage() {
    echo "Usage: ksh <module> [args...]"
    echo ""
    echo "Modules:"
    echo "  vault [backup|restore]  Vaultwarden operations"
    echo "  status                  Show Docker host status"
    echo "  help                    This help"
}

[[ $# -lt 1 ]] && usage && exit 1

case "$1" in
    -h|--help) usage; exit 0 ;;
    vault) shift
        case "${1:-status}" in
            backup) bash "$ROOT/vault/backup.sh" ;;
            restore) bash "$ROOT/vault/restore.sh" "$@" ;;
            *) echo "Usage: ksh vault [backup|restore]" ;;
        esac ;;
    status)
        echo "=== Docker Host Status ==="
        docker ps --format "table {{.Names}}\t{{.Status}}" 2>/dev/null || echo "Docker not available"
        ;;
    *) echo "❌ Unknown module '$1'" && usage && exit 1 ;;
esac
