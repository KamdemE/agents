#!/bin/bash
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

usage() {
    echo "Usage: ksh <module> [args...]"
    echo ""
    echo "Modules:"
    echo "  maintenance         Run PVE maintenance"
    echo "  backup [server|local]   Run PVE backup operations"
    echo "  restore             Restore PVE from cloud backup"
    echo "  watchdog            Network watchdog status"
    echo "  network [switch]    Network interface switching"
    echo "  setup-eduroam       Configure eduroam WiFi"
    echo "  help                This help"
}

[[ $# -lt 1 ]] && usage && exit 1

case "$1" in
    -h|--help) usage; exit 0 ;;
    maintenance) shift; bash "$ROOT/maintenance.sh" "$@" ;;
    backup) shift; bash "$ROOT/backup/backup_server.sh" ;;
    restore) shift; bash "$ROOT/backup/restore.sh" "$@" ;;
    watchdog) shift; bash "$ROOT/network/network_watchdog.sh" "$@" ;;
    network) shift; bash "$ROOT/network/network_switch.sh" "$@" ;;
    setup-eduroam) shift; bash "$ROOT/network/setup_eduroam.sh" "$@" ;;
    *) echo "❌ Unknown module '$1'" && usage && exit 1 ;;
esac
