[Unit]
# ollama6 tunnel — SSH forward 127.0.0.1:11436 -> deep-pc6:11434 (Ollama).
# USER service (runs as kpihx, uses the ~/.ssh/config alias `deep-pc6`).
# Requires the DxO VPN (vpn-dxo.service) to be up; Restart keeps the tunnel
# alive across short VPN idle periods (ServerAlive keepalive inside ssh).
# Managed ON-DEMAND via the ollama6 script: NOT enabled at boot.
Description=Ollama tunnel to Deep-PC6 (SSH forward 11436 -> 11434)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# -v = verbose: journalctl --user -u ollama6-tunnel.service -f SHOWS the live
# tunnel logs (debug1 connection/auth lines, forwarding listener, channel traffic).
# ExitOnForwardFailure fails fast if the local port cannot bind.
ExecStart=/usr/bin/ssh -N -v -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 11436:127.0.0.1:11434 deep-pc6
# Restart ONLY on failure (VPN drop, transient ssh error), not on manual stop.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
