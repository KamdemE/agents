#!/bin/bash
# tmux6 — SSH to deep-pc6 and attach to its tmux session
# Issue guidance: when the VPN or SSH fails, echoes exactly what to do.
set -u

VPN_UNIT="vpn-dxo.service"

# --- vpn_active: exit 0 if the DxO VPN systemd service is running ------------
vpn_active() {
  systemctl is-active --quiet "${VPN_UNIT}"
}

# deep-pc6 is reachable ONLY over the DxO VPN — pre-check to give clear guidance
if ! vpn_active; then
  echo "tmux6: ERROR — the DxO VPN (${VPN_UNIT}) is not connected." >&2
  echo "       deep-pc6 is reachable ONLY over the DxO VPN." >&2
  echo "       What to do:" >&2
  echo "         sudo systemctl start vpn-dxo    # start the VPN" >&2
  echo "         systemctl status vpn-dxo        # check its state" >&2
  echo "         journalctl -u vpn-dxo -f        # follow live VPN logs" >&2
  exit 1
fi

# Attach over SSH; if it fails (host down, auth), explain what to check.
if ssh -t deep-pc6 tmux "$@"; then
  exit 0
else
  echo "tmux6: ERROR — SSH to deep-pc6 failed." >&2
  echo "       What to do:" >&2
  echo "         systemctl status vpn-dxo      # is the VPN still connected?" >&2
  echo "         ping 172.16.150.163           # is deep-pc6 reachable?" >&2
  echo "         ssh deep-pc6                  # test the SSH alias directly" >&2
  exit 1
fi
