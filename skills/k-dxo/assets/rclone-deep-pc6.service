[Unit]
Description=Rclone mount for Deep-PC6 at ~/Deep-PC6 (DxO)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p /home/kpihx/Deep-PC6
ExecStart=/home/kpihx/.local/bin/rclone mount deep-pc6: /home/kpihx/Deep-PC6 \
    --config=/home/kpihx/.config/rclone/rclone.conf \
    --vfs-cache-mode full \
    --allow-other \
    --dir-cache-time 30s \
    --poll-interval 10s \
    --vfs-read-ahead 128M \
    --vfs-cache-max-age 5m \
    --attr-timeout 30s
ExecStop=/bin/fusermount -uz /home/kpihx/Deep-PC6
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
