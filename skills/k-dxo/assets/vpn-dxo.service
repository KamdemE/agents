[Unit]
# DxO GlobalProtect VPN (gpclient) — vpn-ext.dxo.com.
# Managed ON-DEMAND: NOT enabled at boot, zero RAM until started.
Description=DxO GlobalProtect VPN (gpclient)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# gpclient needs root for tun device and /var/run/gpclient.lock.
ExecStart=/usr/bin/gpclient --ignore-tls-errors --fix-openssl connect vpn-ext.dxo.com
# Graceful GlobalProtect logout
ExecStop=/usr/bin/gpclient disconnect
# Restart ONLY on abnormal termination (crash, signal), not on clean exit (MFA expiry).
Restart=on-abnormal
RestartSec=10
# CRITICAL: HOME must point to the user directory to reuse the 30-day session cookie in ~/.local/share/gpclient
Environment=HOME=/home/kpihx SUDO_USER=kpihx SUDO_UID=1000 SUDO_GID=1000

[Install]
WantedBy=multi-user.target
