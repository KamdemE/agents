#!/bin/bash
# ollama6 — run the ollama CLI against deep-pc6's Ollama server.
# CORE FUNCTION ONLY (2026-08-03): proxy the ollama CLI to deep-pc6 through
# the local tunnel endpoint 127.0.0.1:11436. It does NOT manage the VPN or the
# tunnel (no merged responsibility) — on failure it only tells you what to do,
# you start the services yourself with systemctl.

set -eu

OLLAMA6_PORT="11436"
OLLAMA6_HOST="http://127.0.0.1:${OLLAMA6_PORT}"
CHECK_URL="${OLLAMA6_HOST}/api/version"

# --- port_ready: exit 0 if the tunnel endpoint answers, 1 otherwise ----------
port_ready() {
  curl -s --max-time 2 "${CHECK_URL}" >/dev/null 2>&1
}

# --- core: if the tunnel is up, run ollama against deep-pc6; else guide ------
if ! port_ready; then
  echo "ollama6: cannot reach deep-pc6's Ollama at ${OLLAMA6_HOST} (tunnel down)." >&2
  echo "         What to do:" >&2
  echo "           1. Start the DxO VPN:   sudo systemctl start vpn-dxo" >&2
  echo "           2. Check VPN state:     systemctl status vpn-dxo" >&2
  echo "           3. Start the tunnel:    systemctl --user start ollama6-tunnel.service" >&2
  echo "           4. Check tunnel logs:   journalctl --user -u ollama6-tunnel.service -f" >&2
  exit 1
fi

export OLLAMA_HOST="${OLLAMA6_HOST}"
exec ollama "$@"
