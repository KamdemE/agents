.DEFAULT_GOAL := help
# NOTE: no top-level $(shell git ...) — runs as root under 'sudo make' and pollutes .git/.
# Use inline $$(...) inside recipes only.

help:  ## Show available targets
	@grep -E '^[a-zA-Z_-]+:.*?##' $(MAKEFILE_LIST) | \
	  awk 'BEGIN {FS = ":.*?## "}; {printf "  %-15s %s\n", $$1, $$2}'

push:  ## Push current branch to all remotes
	@branch="$$(git branch --show-current)"; \
	for remote in $$(git remote); do \
		echo "==> pushing $$branch to $$remote"; \
		git push "$$remote" "$$branch"; \
	done

push-tags:  ## Push all tags to all remotes
	@for remote in $$(git remote); do git push "$$remote" --tags; done

git-status:  ## git status --short
	@git status --short

# ── Service (systemd) ─────────────────────────────────────────────────────────
# Adapt unit names below to match the project. Remove section if not a service.

status:  ## Show <project> service + timer status (systemd)
	@systemctl status <project>.service <project>.timer --no-pager 2>/dev/null || true

log:  ## Show recent service logs via journald
	@journalctl -u <project> -n 50 --no-pager

run:  ## Run service immediately (requires sudo)
	@sudo bash <main-script>.sh

# ── Project lifecycle ─────────────────────────────────────────────────────────

install:  ## Install project (systemd units, dirs, enable timer) — requires sudo
	@sudo bash install.sh

purge:  ## Purge project (disable timer, remove units) — requires sudo
	@sudo bash purge.sh

lint:  ## Shellcheck on all .sh files
	@shellcheck --shell=bash *.sh
