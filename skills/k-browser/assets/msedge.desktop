[Desktop Entry]
Version=1.0
Name=Microsoft Edge (CDP :9222)
Comment=Edge with persistent remote debugging on port 9222 — survives updates via .agents/ symlink
Exec=msedge --remote-debugging-port=9222 %U
Icon=microsoft-edge
Terminal=false
Type=Application
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;
StartupWMClass=msedge
StartupNotify=true
Actions=new-window;new-private-window;
