{
  "workbench.colorTheme": "Dark Modern",
  "chat.hookFilesLocations": {
    ".github/hooks": true,
    ".claude/settings.json": false,
    ".claude/settings.local.json": false,
    "~/.claude/settings.json": false,
  },
  "chat.useCustomAgentHooks": true,
  "chat.useAgentsMdFile": true,
  "chat.useCustomizationsInParentRepositories": true,
  "github.copilot.chat.agentDebugLog.enabled": true,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.hg/store/**": true,
    "**/Downloads/**": true,
    "**/Documents/**": true,
    "**/Pictures/**": true,
    "**/Videos/**": true,
    "**/Gdrive_X/**": true,
    "**/Gdrive/**": true,
    "**/.npm-global/**": true,
    "**/Work/Others/**": true,
    "**/Work/X/**": true,
    "**/Work/Homelab/presentation/**": true,
    "**/.venv/**": true,
    "**/.tox/**": true,
    "**/.cache/**": true,
    "**/Work/Homelab/data/**": true,
    "**/.gemini/antigravity/brain/**": true,
    "**/.gemini/antigravity/tmp/**": true,
  },
  "docker.extension.enableComposeLanguageServer": false,
  "terminal.integrated.scrollback": 50000,
  "workbench.editor.useModal": "some",
  "securecoder.enabled": true,
  "jupyter.runStartupCommands": [
    "import bigframes",
    "%load_ext bigframes",
    "bigframes.options.bigquery.project = \"kpihx-489121\"",
    "bigframes.options.bigquery.application_name = \"datacloud.cursor\""
  ],
  "chat.viewSessions.orientation": "stacked",
  "python.languageServer": "None",
  "remote.SSH.remotePlatform": {
    "deep-pc6": "linux"
  },
  "diffEditor.codeLens": true,
  "remote.autoForwardPortsSource": "hybrid",
  "chat.mcp.gallery.enabled": true,
}
