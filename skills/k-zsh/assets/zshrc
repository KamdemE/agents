#!/usr/bin/env zsh
# ============================================================
# .zshrc — Interactive Zsh shell (🔴 NEVER MODIFY)
# ============================================================
# Zsh-specific setup only: prompt, plugins, completions.
# Env vars and PATH belong in .kshrc — never duplicate.
# .kshrc.local is the ONLY escape valve for machine-local overrides.
# ============================================================

#   _________  _   _ ____   ____ 
#  |__  / ___|| | | |  _ \ / ___|
#    / /\___ \| |_| | |_) | |    
# _ / /_ ___) |  _  |  _ <| |___ 
# (_)____|____/|_| |_|_| \_\\____|
#
source ~/.kshrc
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="xiong-chiamiov-plus"
# ENABLE_CORRECTION="true"
plugins=( 
    git
    zsh-autosuggestions
    zsh-syntax-highlighting
    zsh-history-substring-search
    colored-man-pages
    colorize
    command-not-found
    alias-finder
)
source $ZSH/oh-my-zsh.sh
# Function to search history with fzf
fzf-history-widget() {
  # List history items with line numbers, keep only the latest unique command, and pipe to fzf
  local selected=$(fc -rl 1 | awk '{sub("^[ ]*[^ ]+[ ]+","",$0);if(!seen[$0]++){print $0}}' | fzf --height 40% --layout=reverse --border --query="$LBUFFER" --bind 'ctrl-c:abort')
  # If an item was selected, replace LBUFFER with it
  if [ -n "$selected" ]; then
    LBUFFER="${selected}"
  fi
  zle redisplay
}
zle -N fzf-history-widget
bindkey '^R' fzf-history-widget
# Style for alias-finder
zstyle ':omz:plugins:alias-finder' autoload yes # disabled by default
zstyle ':omz:plugins:alias-finder' longer yes # disabled by default
zstyle ':omz:plugins:alias-finder' exact yes # disabled by default
zstyle ':omz:plugins:alias-finder' cheaper yes # disabled by default
# aliases
alias la="ls -a"
alias -g F=" | fzf"
alias -g G=" | grep"
alias -s pdf="evince "
alias -s py="python3 "
alias calc="noglob _calc"
alias C="calc"
_calc() {
    echo "scale=10; $*" | bc -l
}
# for zsh-interactive-cd plugin
source ~/.oh-my-zsh/plugins/zsh-interactive-cd/zsh-interactive-cd.plugin.zsh

# To change the cursor to |
echo '\e[5 q'

# Machine-local configs (PATH, completions, auto-tmux) moved to ~/.kshrc

# fnm is loaded via ~/.kshrc (universal shell hub)
export TRASH="$HOME/.local/share/Trash"
