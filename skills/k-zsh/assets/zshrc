#!/usr/bin/env zsh
# ============================================================
# .zshrc — Zsh Interactive Shell (🔴 NEVER MODIFY)
# ============================================================
# ╔══════════════════════════════════════════════════════════╗
# ║  DO NOT EDIT THIS FILE                                  ║
# ║  Source of truth: .agents/skills/k-ubuntu/assets/zshrc  ║
# ║  Edit there, then re-symlink:                           ║
# ║    ln -sf ~/.agents/skills/k-ubuntu/assets/zshrc ~/.zshrc ║
# ║  .kshrc.local is the ONLY escape valve for local overrides ║
# ╚══════════════════════════════════════════════════════════╝
# ============================================================
#
# ZSH-ONLY — sourced for interactive zsh sessions
# - Sources .kshrc as the universal hub
# - oh-my-zsh: theme, plugins, completions
# - Zsh-specific: fzf widget, zstyle, aliases (zsh-only syntax)
# - DO NOT add PATH or exports here — use .kshrc Section 1
# ============================================================

# ── 1. Universal shell hub ──────────────────────────────────
source ~/.kshrc

# ── 2. oh-my-zsh ────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="xiong-chiamiov-plus"

plugins=(
    git
    zsh-autosuggestions
    zsh-syntax-highlighting
    zsh-history-substring-search
    colored-man-pages
    colorize
    command-not-found
    alias-finder
)

source "$ZSH/oh-my-zsh.sh"

# ── 3. fzf history search (Ctrl+R) ──────────────────────────
fzf-history-widget() {
  local selected=$(fc -rl 1 | awk '{sub("^[ ]*[^ ]+[ ]+","",$0);if(!seen[$0]++)print $0}' \
    | fzf --height 40% --layout=reverse --border --query="$LBUFFER" --bind 'ctrl-c:abort')
  if [ -n "$selected" ]; then
    LBUFFER="${selected}"
  fi
  zle redisplay
}
zle -N fzf-history-widget
bindkey '^R' fzf-history-widget

# ── 4. Zsh-specific aliases ─────────────────────────────────
alias -g F=" | fzf"
alias -g G=" | grep"
alias -s pdf="evince "
alias -s py="python3 "
alias calc="noglob _calc"
alias C="calc"
_calc() {
    echo "scale=10; $*" | bc -l
}

# ── 5. oh-my-zsh plugin extras ──────────────────────────────
[ -f "$HOME/.oh-my-zsh/plugins/zsh-interactive-cd/zsh-interactive-cd.plugin.zsh" ] \
  && source "$HOME/.oh-my-zsh/plugins/zsh-interactive-cd/zsh-interactive-cd.plugin.zsh"

# ── 6. Visual ───────────────────────────────────────────────
echo '\e[5 q'

# ── 7. zstyle (omz plugin config) ───────────────────────────
zstyle ':omz:plugins:alias-finder' autoload yes
zstyle ':omz:plugins:alias-finder' longer yes
zstyle ':omz:plugins:alias-finder' exact yes
zstyle ':omz:plugins:alias-finder' cheaper yes

