# - .kshrc Section 1 already handles universal exports
# ============================================================

# ── Source the universal hub ────────────────────────────────
# .kshrc Section 1 (universal) provides PATH, EDITOR, OLLAMA...
# Section 2 (interactive) is auto-skipped for non-interactive shells.
[ -f "$HOME/.kshrc" ] && source "$HOME/.kshrc"

