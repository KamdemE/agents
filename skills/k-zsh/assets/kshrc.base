# ============================================================
# .kshrc.base — KπX Universal Shell Hub (deploy template)
# ============================================================
# Minimal base for a new machine.
# Copy to $HOME/.kshrc, then add machine-specific env/PATH/etc.
# ============================================================

# ── Interactive-only (aliases, history, colors) ─────────────
case $- in *i*) ;; *) return ;; esac

# History
HISTCONTROL=ignoreboth
HISTSIZE=1000
HISTFILESIZE=2000

# Color support
if [ -x /usr/bin/dircolors ]; then
  test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
  alias ls='ls --color=auto'
  alias grep='grep --color=auto'
  alias fgrep='fgrep --color=auto'
  alias egrep='egrep --color=auto'
fi

# Aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
# rm is now a ~/.local/bin/ wrapper (trash-cli). See k-clis/assets/rm
alias ta='tmux-attach'

if [ -f ~/.bash_aliases ]; then
  . ~/.bash_aliases
fi

# === Tool aliases ===
[ -x /usr/bin/batcat ] && alias bat=batcat

setopt HIST_IGNORE_SPACE
