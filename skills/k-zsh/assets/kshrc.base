#!/usr/bin/env zsh
# ============================================================
# .kshrc.base — KπX Universal Shell Hub (deploy template)
# ============================================================
# Minimal base for a new machine.
# Copy to $HOME/.kshrc, then add machine-specific env/PATH/etc.
# ============================================================

# === with-env helper ===
# Execute command with loaded environment variables from an env file (default: ~/.agents/.env)
# Usage: with-env [-e/--env-file <file>] <command> [args...]
with-env() {
    local env_file="$HOME/.agents/.env"
    if [[ "$1" == "-e" || "$1" == "--env-file" ]]; then
        env_file="$2"
        shift 2
    fi
    if [ ! -f "$env_file" ]; then
        echo "❌ Error: Env file '$env_file' not found." >&2
        return 1
    fi
    if [ $# -eq 0 ]; then
        echo "Usage: with-env [-e/--env-file <file>] <command> [args...]" >&2
        return 1
    fi
    (
        set -a
        source "$env_file"
        set +a
        "$@"
    )
}

# ── Interactive-only (aliases, history, colors) ─────────────
case $- in *i*) ;; *) return ;; esac

# Autocomplete for with-env
if [ -n "$ZSH_VERSION" ] && type compdef >/dev/null 2>&1; then
    compdef _precommand with-env
fi

# History
HISTCONTROL=ignoreboth
HISTSIZE=1000
HISTFILESIZE=2000

# Color support
if [ -x /usr/bin/dircolors ]; then
  test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
  alias ls='ls --color=auto'
  alias grep='grep --color=auto'
  alias fgrep='fgrep --color=auto'
  alias egrep='egrep --color=auto'
fi

# Aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
# rm is now a ~/.local/bin/ wrapper (trash-cli). See k-clis/assets/rm
alias ta='tmux-attach'

if [ -f ~/.bash_aliases ]; then
  . ~/.bash_aliases
fi

# === Tool aliases ===
[ -x /usr/bin/batcat ] && alias bat=batcat

setopt HIST_IGNORE_SPACE

# ── Auto-tmux (LAST — after full shell init, before prompt) ──────────────
# Auto-attach to this infra's tmux session when opening a new shell.
# Replace <INFRA_SESSION> with the equipment name (ubuntu, pve, s25, etc.).
# See k-tmux/SKILL.md → Standard session per equipment.
if [ -z "$TMUX" ] && command -v tmux >/dev/null 2>&1; then
  tmux has-session -t <INFRA_SESSION> 2>/dev/null && tmux attach -t <INFRA_SESSION>
fi
