{
  "$schema": "https://opencode.ai/config.json",

  // KπX sovereign wiring — source of truth: $HOME/.agents/skills/k-opencode/SKILL.md
  // v1.19.0 — .env protection (edit + bash deny, .env.example allow)
  "autoupdate": "notify",
  "shell": "zsh",
  "model": "opencode/deepseek-v4-flash-free",
  "small_model": "opencode-go/deepseek-v4-flash",
  "default_agent": "Colab",

  // ──── GLOBAL permission — single source of truth ────
  // All agents inherit from here. Per-agent blocks define ONLY deltas.
  "permission": {
    "edit": {
      "*": "ask",
      "*.env": "deny",
      "*.env.example": "allow"
    },
    "webfetch": "allow",
    "doom_loop": "ask",
    "skill": { "*": "allow" },

    // ──── Read — .env protection ────
    "read": {
      "*.env": "deny",
      "*.env.example": "allow"
    },

    // ──── Bash — 3-zone allow + explicit ask ────
    "bash": {
      // ──── ALLOW — Zone 1 : read-only purs (zero risque) ────
      "arch": "allow",
      "basename *": "allow",
      "cmp *": "allow",
      "comm *": "allow",
      "cut *": "allow",
      "date *": "allow",
      "diff *": "allow",
      "dirname *": "allow",
      "echo *": "allow",
      "env": "allow",
      "expand *": "allow",
      "file *": "allow",
      "find *": "allow",
      "fmt *": "allow",
      "fold *": "allow",
      "free *": "allow",
      "getconf *": "allow",
      "grep *": "allow",
      "groups *": "allow",
      "head *": "allow",
      "hostname": "allow",
      "id *": "allow",
      "jq *": "allow",
      "join *": "allow",
      "locale *": "allow",
      "logname": "allow",
      "ls*": "allow",
      "man *": "allow",
      "md5sum *": "allow",
      "mktemp *": "allow",
      "more *": "allow",
      "nl *": "allow",
      "nproc": "allow",
      "numfmt *": "allow",
      "paste *": "allow",
      "pr *": "allow",
      "printenv": "allow",
      "printf *": "allow",
      "pwd": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "rg *": "allow",
      "seq *": "allow",
      "sha1sum *": "allow",
      "sha256sum *": "allow",
      "sha512sum *": "allow",
      "shuf *": "allow",
      "sort *": "allow",
      "split *": "allow",
      "stat *": "allow",
      "strings *": "allow",
      "tac *": "allow",
      "tail *": "allow",
      "test *": "allow",
      "timedatectl *": "allow",
      "tr *": "allow",
      "tty": "allow",
      "uname *": "allow",
      "unexpand *": "allow",
      "uniq *": "allow",
      "uptime": "allow",
      "users *": "allow",
      "wc *": "allow",
      "whatis *": "allow",
      "whereis *": "allow",
      "which *": "allow",
      "who *": "allow",
      "whoami": "allow",

      // ──── ALLOW — Zone 2 : faible risque (network / navigation) ────
      "command *": "allow",
      "curl *": "allow",
      "df *": "allow",
      "dig *": "allow",
      "du *": "allow",
      "gh *": "allow",
      "glab *": "allow",
      "host *": "allow",
      "nslookup *": "allow",
      "ping *": "allow",
      "sleep *": "allow",
      "ss *": "allow",
      "timeout *": "allow",
      "tmux *": "allow",
      "traceroute *": "allow",
      "tree *": "allow",
      "type *": "allow",
      "w *": "allow",
      "watch *": "allow",
      "wget *": "allow",
      "yes *": "allow",

      // ──── ALLOW — Zone 3 : confiance (dev, file ops non destructeurs) ────
      "alias*": "allow",
      "apropos *": "allow",
      "awk *": "ask",
      "bat *": "allow",
      "bun *": "allow",
      "bzip2 *": "allow",
      "bunzip2 *": "allow",
      "cat *": "allow",
      "cat * > *": "deny",
      "cat * >> *": "deny",
      "cd *": "allow",
      "cp *": "ask",
      "docker *": "allow",
      "docker rm*": "ask",
      "docker stop*": "ask",
      "docker kill*": "ask",
      "docker rmi*": "ask",
      "git *": "ask",
      "git push --force*": "ask",
      "git clean *": "ask",
      "git restore *": "ask",
      "git reset *": "ask",
      "go *": "allow",
      "gzip *": "allow",
      "gunzip *": "allow",
      "iconv *": "allow",
      "ip *": "allow",
      "jupyter *": "allow",
      "less *": "allow",
      "ln *": "ask",
      "lscpu *": "allow",
      "lsof *": "allow",
      "lspci *": "allow",
      "lsusb *": "allow",
      "make *": "allow",
      "mkdir *": "allow",
      "mv *": "ask",
      "nvim *": "allow",
      "node *": "allow",
      "nohup *": "ask",
      "npm *": "allow",
      "npx *": "allow",
      "opencode *": "allow",
      "pgrep *": "ask",
      "pip *": "allow",
      "pip3 *": "allow",
      "pnpm *": "allow",
      "ps *": "allow",
      "python3 *": "allow",
      "rclone *": "allow",
      "rsync *": "allow",
      "rsync --delete*": "ask",
      "ruby *": "allow",
      "scp *": "allow",
      "sftp *": "allow",
      "screen *": "ask",
      "source *": "ask",
      "sqlite3 *": "allow",
      "ssh *": "allow",
      "tailscale *": "allow",
      "tar *": "allow",
      "tee *": "allow",
      "tmux kill-pane*": "ask",
      "tmux kill-session*": "ask",
      "tmux kill-window*": "ask",
      "tmux send-keys*": "ask",
      "touch *": "allow",
      "unzip *": "allow",
      "uv *": "allow",
      "xargs *": "allow",
      "xz *": "allow",
      "unxz *": "allow",
      "yarn *": "allow",
      "zip *": "allow",
      "zsh *": "ask",
      "zstd *": "allow",
      "unzstd *": "allow",

      // ──── ASK — commandes dangereuses (liste explicite) ────
      "rm": "ask",
      "rm *": "ask",
      // /usr/bin/rm and /bin/rm are DENIED — they bypass the safe trash wrapper. Use `rm` instead.
      "/usr/bin/rm": "deny",
      "/usr/bin/rm *": "deny",
      "/bin/rm": "deny",
      "/bin/rm *": "deny",
      "rmdir *": "ask",
      "shred *": "ask",
      "sed *": "ask",
      "pkill *": "ask",
      "kill *": "ask",
      "killall *": "ask",
      "sudo *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "chattr *": "ask",
      "dd *": "ask",
      "fdisk *": "ask",
      "parted *": "ask",
      "mkfs*": "ask",
      "mount *": "ask",
      "umount *": "ask",
      "systemctl *": "ask",
      "apt *": "ask",
      "apt-get *": "ask",
      "dpkg *": "ask",
      "snap *": "ask",
      "flatpak *": "ask",
      "passwd *": "ask",
      "useradd *": "ask",
      "usermod *": "ask",
      "userdel *": "ask",
      "groupadd *": "ask",
      "groupmod *": "ask",
      "groupdel *": "ask",
      "shutdown *": "ask",
      "reboot *": "ask",
      "halt *": "ask",
      "poweroff *": "ask",
      "init *": "ask",
      "crontab *": "ask",
      "update-alternatives *": "ask",

      // ──── File-level restrictions (findLast: deny .env, allow .env.example) ────
      "*.env": "deny",
      "*.env.example": "allow"
    },

    // ──── External directories ────
    "external_directory": {
      "~/.agents/**": "allow",
      "~/.config/**": "allow",
      "/tmp/**": "allow",
      "~/Downloads/**": "allow",
      "~/Pictures/**": "allow",
      "~/Gdrive_X/**": "allow",
      "~/Gdrive/**": "allow",
      "~/KpihX-Labs/**": "allow",
      "~/.local/**": "allow"
    },

    // ──── MCP chrome-agent — all allow ────
    "chrome-agent_*": "allow"
  },

  // ──── AGENT deltas — only overrides from global ────
  // Source of truth for agent prompts/descriptions: ~/.agents/agents/*/agent.txt
  // This section defines ONLY provider-specific overrides (model, permissions, colors).
  "agent": {
    // Build: inherits everything from global — no delta needed
    // "Build": {},

    // Lite: minimal agent with Ollama — inherits global, denies skills + MCPs
    "Lite": {
      "model": "ollama/qwen2.5-ctx12k",
      "description": "Minimal tool-execution agent. bash + read/write + websearch. No rules, no skills overhead.",
      "prompt": "You are in LITE mode. Strict rules: 1) Use `bash ls` to list directory contents (never use `read` on directories). 2) English only.",
      "mode": "primary",
      "color": "#FF9800",
      "permission": {
        "skill": "deny",
        "task": "deny",
        "mail_fallback_*": "deny",
        "tick_fallback_*": "deny",
        "chrome-agent_*": "deny",
        "linkedin_*": "deny"
      }
    },

    // Auto: catch-all *: allow — NO tool blocked, can launch ALL sub-agents
    // ALL *rm* commands are blocked by wildcard, then `rm` (trash wrapper) is explicitly re-allowed.
    // This means ANY variant (/usr/bin/rm, /bin/rm, rm -rf, etc.) is blocked — only bare `rm` works.
    "Auto": {
      "model": "opencode/deepseek-v4-flash-free",
      "description": "Auto agent — full permissions, all tools allowed, all sub-agents callable, future-proof",
      "mode": "primary",
      "color": "#F44336",
      "permission": {
        "*": "allow",
        "bash": {
          "*rm*": "deny",
          "rm": "allow",
          "rm *": "allow"
        }
      }
    },

    // Plan: built-in read-only agent
    // "Plan": {
    //   "permission": {
    //     "edit": "deny",
    //     "bash": {
    //       "*": "deny",
    //       "git diff*": "allow",
    //       "git log*": "allow",
    //       "rg *": "allow"
    //     }
    //   }
    // },

    // Colab 🟢 — exploitation mode. Inherits global (bash 3-zone, edit ask).
    // Delta: task — which sub-agents Colab can launch.
    "Colab": {
      "description": "Exploitation agent — coordinates execution, delegates to sub-agents, verifies quality. My main work mode for building.",
      "mode": "primary",
      "color": "#4CAF50",
      "prompt": "{file:~/.agents/agents/Colab/prompt.txt}",
      "permission": {
        "task": {
          "*": "deny",
          "executor": "allow",
          "intent-guardian": "allow",
          "pragmatic-checker": "allow",
          "curator": "allow",
          "explore": "allow",
          "general": "allow",
          "scout": "allow"
        }
      }
    },

    // Explore 🔵 — exploration mode. Inherits global (bash 3-zone, edit ask).
    // Delta: task — which sub-agents Explore can launch.
    "Explore": {
      "model": "google/gemini-3-flash-preview",
      "description": "Exploration agent — teaches, researches, verifies. Intuitio-formel narrative style for learning.",
      "mode": "primary",
      "color": "#2196F3",
      "prompt": "{file:~/.agents/agents/Explore/prompt.txt}",
      "permission": {
        "task": {
          "*": "deny",
          "fact-verifier": "allow",
          "scout": "allow",
          "explore": "allow",
          "general": "allow"
        }
      }
    },

    // Agent 🟣 — end-to-end solo execution mode. The OPPOSITE of Colab.
    // Built for one thing: take a big task from start to finish, no matter how long.
    // Holds ONLY the objective. Iterates until 100% done. All sub-agents at disposal.
    // Delta: task → ALL sub-agents allowed. tmux send-keys + capture-pane allowed (ops pane).
    "Agent": {
      "description": "End-to-end solo agent — holds only the objective, iterates until fully achieved. All sub-agents at disposal.",
      "mode": "primary",
      "color": "#9C27B0",
      "prompt": "{file:~/.agents/agents/Agent/prompt.txt}",
      "permission": {
        "task": {
          "*": "allow"
        },
        "bash": {
          "tmux send-keys*": "allow",
          "tmux capture-pane*": "allow"
        }
      }
    }
  },

  // ──── Provider — auto-discovered + custom ────
  // ──── Provider — auto-discovered + custom ────
  // ──── Provider — auto-discovered + custom ────
  // ──── Provider — auto-discovered + custom ────
  // ──── Provider — auto-discovered + custom ────
  // ──── Provider — auto-discovered + custom ────
  "provider": {
    "ollama6": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama6",
      "options": {
        "baseURL": "http://localhost:11436/v1"
      },
      "models": {
        "R4C3R/mistral-7b-instruct-v0.3-heretic:q4_k_m": { "name": "R4C3R/mistral-7b-instruct-v0.3-heretic:q4_k_m (4.1 GB — deep-pc6)" },
        "R4C3R/qwen2.5-coder-7b-instruct-heretic:q8_0": { "name": "R4C3R/qwen2.5-coder-7b-instruct-heretic:q8_0 (7.5 GB — deep-pc6)" },
        "R4C3R/qwen3-8b-heretic:q4_k_m": { "name": "R4C3R/qwen3-8b-heretic:q4_k_m (4.7 GB — deep-pc6)" },
        "byczech/glm-4.7-flash-uncensored-16G-AU-IQ3_M:30b": { "name": "byczech/glm-4.7-flash-uncensored-16G-AU-IQ3_M:30b (12.7 GB — deep-pc6)" },
        "gemma3:27b": { "name": "gemma3:27b (16.2 GB — deep-pc6)" },
        "gpt-oss:20b": { "name": "gpt-oss:20b (12.8 GB — deep-pc6)" },
        "jikepjikep_16HEX/gemma-4-26b-nightshift-heretic-uncensored-a4b-moe-q4:latest": { "name": "jikepjikep_16HEX/gemma-4-26b-nightshift-heretic-uncensored-a4b-moe-q4:latest (16.8 GB — deep-pc6)" },
        "ministral-3:8b": { "name": "ministral-3:8b (5.6 GB — deep-pc6)" },
        "mistral-small3.1:24b": { "name": "mistral-small3.1:24b (14.4 GB — deep-pc6)" },
        "mistral-small3.2:24b": { "name": "mistral-small3.2:24b (14.1 GB — deep-pc6)" },
        "mistral-small:24b": { "name": "mistral-small:24b (13.3 GB — deep-pc6)" },
        "mo-shakib/gemma4-e4b-uncensored:q4_k_m": { "name": "mo-shakib/gemma4-e4b-uncensored:q4_k_m (8.9 GB — deep-pc6)" },
        "qwen3-vl:32b": { "name": "qwen3-vl:32b (19.5 GB — deep-pc6)" },
        "qwen3-vl:8b": { "name": "qwen3-vl:8b (5.7 GB — deep-pc6)" },
        "qwen3:30b": { "name": "qwen3:30b (17.3 GB — deep-pc6)" },
        "sorc/qwen3.5-uncensored:9b": { "name": "sorc/qwen3.5-uncensored:9b (8.9 GB — deep-pc6)" },
        "tripolskypetr/qwen3.6-uncensored-aggressive:latest": { "name": "tripolskypetr/qwen3.6-uncensored-aggressive:latest (19.7 GB — deep-pc6)" }
      }
    },
    // Ollama local — auto-synced by opencode-ollama.sh
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5": { "name": "qwen2.5:latest (4.4 GB local)" },
        "qwen3": { "name": "qwen3:latest (4.9 GB local)" },
        "phi4-mini": { "name": "phi4-mini:latest (2.3 GB local)" }
      }
    },
  },

  "mcp": {
    // Browser MCP — CAPTCHA/2FA/formulaires spéciaux
    "browser": {
      "type": "local",
      "command": ["browser-mcp"],
      "enabled": true,
      "timeout": 60000
    },
    // Chrome Agent MCP → 90% (navigation, tabs, devtools, contenu)
    "chrome-agent": {
      "type": "local",
      "command": ["chrome-agent-mcp"],
      "enabled": true,
      "timeout": 60000
    },

    // Loom MCP → persistent code index for cross-session search
    // Use `uv tool install loom-tool` first (loom-mcp binary in PATH)
    "loom": {
      "type": "local",
      "command": ["loom-mcp"],
      "enabled": true,
      "timeout": 60000
    },

    // Exa Search MCP → web search via Exa API
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "2ae0e508-3c8f-468f-8870-4446fbb084d2"
      },
      "enabled": true,
      "timeout": 30000
    }
  },

  "watcher": {
    "ignore": [
      "node_modules/**", ".git/**", "**/__pycache__/**",
      ".venv/**", "dist/**", "build/**", ".cursor/**"
    ]
  },

  "plugin": [
    "opencode-dir",
    "opencode-ssh-session",
    "opencode-ast",
    "opencode-antigravity-auth@latest",
    "opencode-claude-auth",
    // Runtime hooks — re-enabled 2026-08-09 (KπX directive). Order matters (see k-opencode/SKILL.md).
    // 2026-08-16: hooks moved scripts/hooks → scripts/plugins/hooks (KπX restructure); tmux-notify.js was
    // in scripts/plugins/tmux/, flattened directly into scripts/plugins/ same day (KπX: "plus besoin de
    // dossier tmux, mets ce plugin directement dans plugins") — no more tmux/ subfolder.
    "file:///home/kpihx/.agents/skills/k-opencode/scripts/plugins/hooks/startup-context.js",
    "file:///home/kpihx/.agents/skills/k-opencode/scripts/plugins/hooks/prompt-enforcer-lite.js",
    "file:///home/kpihx/.agents/skills/k-opencode/scripts/plugins/hooks/prompt-enforcer-strict.js",
    "file:///home/kpihx/.agents/skills/k-opencode/scripts/plugins/hooks/stop-enforcer.js",
    "file:///home/kpihx/.agents/skills/k-opencode/scripts/plugins/hooks/make-check-guard.js",
    // tmux-notify — relays tmux prompt events (precmd/PROMPT_COMMAND) to the agent (event + chat.message, not messages.transform).
    "file:///home/kpihx/.agents/skills/k-opencode/scripts/plugins/tmux-notify.js",
    "file:///home/kpihx/.agents/skills/k-opencode/scripts/plugins/hooks/math-enforcer.js",
    "file:///home/kpihx/.agents/skills/k-opencode/scripts/plugins/hooks/suggestions-check.js",
    // /context plugin — explicit file:// (1.18.16 auto-discovery glob is non-recursive; explicit path is the reliable mechanism, same as plugins).
    "file:///home/kpihx/.agents/skills/k-opencode/scripts/plugins/opencode-context/context-usage.ts"
  ],

  "compaction": {
    "auto": true,
    "prune": true
  },
  "disabled_providers": [
    "k-ai"
  ]
}
