{
  "$schema": "https://opencode.ai/config.json",

  // KπX sovereign wiring — source of truth: $HOME/.agents/skills/k-opencode/SKILL.md
  // v1.20.0 — .env protection (edit + read deny, .env.example allow) + raw-exec-guard.js .env bash enforcement
  "autoupdate": "notify",
  "shell": "zsh",
  "model": "opencode-go/mimo-v2.5",
  "small_model": "opencode-go/mimo-v2.5",
  "default_agent": "Live",

  // ──── GLOBAL permission — single source of truth ────
  // All agents inherit from here. Per-agent blocks define ONLY deltas.
  "permission": {
    "edit": {
      "*": "ask",
      "*.env": "deny",
      "*.env.example": "allow"
    },
    "webfetch": "allow",
    "doom_loop": "ask",
    "skill": { "*": "allow" },

    // ──── Read — .env protection ────
    "read": {
      "*.env": "deny",
      "*.env.example": "allow"
    },

    // ──── Bash — 3-zone allow + explicit ask ────
    "bash": {
      // ──── ALLOW — Zone 1 : read-only purs (zero risque) ────
      "arch": "allow",
      "basename *": "allow",
      "cmp *": "allow",
      "comm *": "allow",
      "cut *": "allow",
      "date *": "allow",
      "diff *": "allow",
      "dirname *": "allow",
      "echo *": "allow",
      "env": "ask",
      "expand *": "allow",
      "file *": "allow",
      "find *": "allow",
      "fmt *": "allow",
      "fold *": "allow",
      "free *": "allow",
      "getconf *": "allow",
      "grep *": "allow",
      "groups *": "allow",
      "head *": "allow",
      "hostname": "allow",
      "id *": "allow",
      "jq *": "allow",
      "join *": "allow",
      "locale *": "allow",
      "logname": "allow",
      "ls*": "allow",
      "man *": "allow",
      "md5sum *": "allow",
      "mktemp *": "allow",
      "more *": "allow",
      "nl *": "allow",
      "nproc": "allow",
      "numfmt *": "allow",
      "paste *": "allow",
      "pr *": "allow",
      "printenv": "ask",
      "printf *": "allow",
      "set *": "ask",
      "export *": "ask",
      "compgen *": "ask",
      "pwd": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "rg *": "allow",
      "seq *": "allow",
      "sha1sum *": "allow",
      "sha256sum *": "allow",
      "sha512sum *": "allow",
      "shuf *": "allow",
      "sort *": "allow",
      "split *": "allow",
      "stat *": "allow",
      "strings *": "allow",
      "tac *": "allow",
      "tail *": "allow",
      "test *": "allow",
      "timedatectl *": "allow",
      "tr *": "allow",
      "tty": "allow",
      "uname *": "allow",
      "unexpand *": "allow",
      "uniq *": "allow",
      "uptime": "allow",
      "users *": "allow",
      "wc *": "allow",
      "whatis *": "allow",
      "whereis *": "allow",
      "which *": "allow",
      "who *": "allow",
      "whoami": "allow",

      // ──── ALLOW — Zone 2 : faible risque (network / navigation) ────
      "command *": "allow",
      "curl *": "allow",
      // ──── DENY — POST to localhost (block HITL bypass — KπX 2026-09-01) ────
      "curl * -X POST * 127.0.0.1 *": "deny",
      "curl * -X POST * localhost *": "deny",
      "curl * -X POST * ::1 *": "deny",
      "curl * --data * 127.0.0.1 *": "deny",
      "curl * --data * localhost *": "deny",
      "curl * --data * ::1 *": "deny",
      "curl * -d * 127.0.0.1 *": "deny",
      "curl * -d * localhost *": "deny",
      "curl * -d * ::1 *": "deny",
      "df *": "allow",
      "dig *": "allow",
      "du *": "allow",
      "gh *": "allow",
      "glab *": "allow",
      "host *": "allow",
      "nslookup *": "allow",
      "ping *": "allow",
      "sleep *": "allow",
      "ss *": "allow",
      "timeout *": "allow",
      "tmux *": "allow",
      "traceroute *": "allow",
      "tree *": "allow",
      "type *": "allow",
      "w *": "allow",
      "watch *": "allow",
      "wget *": "allow",
      "yes *": "allow",

      // ──── ALLOW — Zone 3 : confiance (dev, file ops non destructeurs) ────
      "alias*": "allow",
      "apropos *": "allow",
      "awk *": "ask",
      "bat *": "allow",
      "bun *": "allow",
      "bzip2 *": "allow",
      "bunzip2 *": "allow",
      "cat *": "allow",
      "cat * > *": "deny",
      "cat * >> *": "deny",
      "cd *": "allow",
      "cp *": "ask",
      "docker *": "allow",
      "docker rm*": "ask",
      "docker stop*": "ask",
      "docker kill*": "ask",
      "docker rmi*": "ask",
      "git *": "ask",
      "git push --force*": "ask",
      "git clean *": "ask",
      "git restore *": "ask",
      "git reset *": "ask",
      "go *": "allow",
      "gzip *": "allow",
      "gunzip *": "allow",
      "iconv *": "allow",
      "ip *": "allow",
      "jupyter *": "allow",
      "less *": "allow",
      "ln *": "ask",
      "lscpu *": "allow",
      "lsof *": "allow",
      "lspci *": "allow",
      "lsusb *": "allow",
      "make *": "allow",
      "mkdir *": "allow",
      "mv *": "ask",
      "nvim *": "allow",
      "node *": "allow",
      "nohup *": "ask",
      "npm *": "allow",
      "npx *": "allow",
      "opencode *": "allow",
      "pgrep *": "ask",
      "pip *": "allow",
      "pip3 *": "allow",
      "pnpm *": "allow",
      "ps *": "allow",
      "python3 *": "allow",
      "rclone *": "allow",
      "rsync *": "allow",
      "rsync --delete*": "ask",
      "ruby *": "allow",
      "scp *": "allow",
      "sftp *": "allow",
      "screen *": "ask",
      "source *": "ask",
      "sqlite3 *": "allow",
      "ssh *": "allow",
      "tailscale *": "allow",
      "tar *": "allow",
      "tee *": "allow",
      "tmux kill-pane*": "ask",
      "tmux kill-session*": "ask",
      "tmux kill-window*": "ask",
      "tmux send-keys*": "ask",
      "touch *": "allow",
      "unzip *": "allow",
      "uv *": "allow",
      "xargs *": "allow",
      "xz *": "allow",
      "unxz *": "allow",
      "yarn *": "allow",
      "zip *": "allow",
      "zsh *": "ask",
      "zstd *": "allow",
      "unzstd *": "allow",

      // ──── ASK — commandes dangereuses (liste explicite) ────
      "rm": "ask",
      "rm *": "ask",
      // /usr/bin/rm and /bin/rm are DENIED — they bypass the safe trash wrapper. Use `rm` instead.
      "/usr/bin/rm": "deny",
      "/usr/bin/rm *": "deny",
      "/bin/rm": "deny",
      "/bin/rm *": "deny",
      "rmdir *": "ask",
      "shred *": "ask",
      "sed *": "ask",
      "pkill *": "ask",
      "kill *": "ask",
      "killall *": "ask",
      "sudo *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "chattr *": "ask",
      "dd *": "ask",
      "fdisk *": "ask",
      "parted *": "ask",
      "mkfs*": "ask",
      "mount *": "ask",
      "umount *": "ask",
      "systemctl *": "ask",
      "apt *": "ask",
      "apt-get *": "ask",
      "dpkg *": "ask",
      "snap *": "ask",
      "flatpak *": "ask",
      "passwd *": "ask",
      "useradd *": "ask",
      "usermod *": "ask",
      "userdel *": "ask",
      "groupadd *": "ask",
      "groupmod *": "ask",
      "groupdel *": "ask",
      "shutdown *": "ask",
      "reboot *": "ask",
      "halt *": "ask",
      "poweroff *": "ask",
      "init *": "ask",
      "crontab *": "ask",
      "update-alternatives *": "ask",

      // ──── File-level restrictions (findLast: deny .env, allow .env.example) ────
      "*.env": "deny",
      "*.env.example": "allow"
    },

    // ──── External directories ────
    "external_directory": {
      "~/.agents/**": "ask",
      "~/.config/**": "ask",
      "/tmp/**": "allow",
      "~/Downloads/**": "allow",
      "~/Pictures/**": "allow",
      "~/Gdrive_X/**": "allow",
      "~/Gdrive/**": "allow",
      "~/KpihX-Labs/**": "allow",
      "~/KpihX-Labs/.agents/**": "ask",
      "~/.local/**": "ask",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny"
    },

    // ──── MCP chrome-agent — all allow ────
    "chrome-agent_*": "allow"
  },

  // ──── AGENT deltas — only overrides from global ────
  // Source of truth for agent prompts/descriptions: ~/.agents/agents/*/agent.txt
  // This section defines ONLY provider-specific overrides (model, permissions, colors).
  "agent": {
    // Build: inherits everything from global — no delta needed
    // "Build": {},

    // Lite: minimal agent — prompt from agents/Lite/prompt.txt (standard, like Colab/Live/Explore/Agent). No general AGENTS.md injected (stripped by lite-instructions-swap.js).
    "Lite": {
      "model": "opencode-go/mimo-v2.5",
      "description": "Minimal tool-execution agent. bash + read/write + google search/fetch. No rules, no skills overhead.",
      "prompt": "{file:~/.agents/agents/Lite/prompt.txt}",
      "mode": "primary",
      "color": "#FF9800",
      "permission": {
        "skill": "deny",
        "task": "deny",
        "exa_web_search_exa": "deny",
        "exa_web_fetch_exa": "deny",
        "webfetch": "allow"
      }
    },

    // Auto: catch-all *: allow — NO tool blocked, can launch ALL sub-agents
    // ALL *rm* commands are blocked by wildcard, then `rm` (trash wrapper) is explicitly re-allowed.
    // This means ANY variant (/usr/bin/rm, /bin/rm, rm -rf, etc.) is blocked — only bare `rm` works.
    "Auto": {
      "model": "opencode-go/mimo-v2.5",
      "description": "Auto agent — full permissions, all tools allowed, all sub-agents callable, future-proof",
      "mode": "primary",
      "color": "#F44336",
      "permission": {
        "*": "allow",
        "bash": {
          "*rm*": "deny",
          "rm": "allow",
          "rm *": "allow"
        }
      }
    },

    // Plan: built-in read-only agent
    // "Plan": {
    //   "permission": {
    //     "edit": "deny",
    //     "bash": {
    //       "*": "deny",
    //       "git diff*": "allow",
    //       "git log*": "allow",
    //       "rg *": "allow"
    //     }
    //   }
    // },

    // Colab 🟢 — exploitation mode. Inherits global (bash 3-zone, edit ask).
    // Delta: task — which sub-agents Colab can launch.
    "Colab": {
      "description": "Exploitation agent — coordinates execution, delegates to sub-agents, verifies quality. My main work mode for building.",
      "mode": "primary",
      "color": "#4CAF50",
      "prompt": "{file:~/.agents/agents/Colab/prompt.txt}",
      "permission": {
        "task": {
          "*": "deny",
          "executor": "allow",
          "intent-guardian": "allow",
          "pragmatic-checker": "allow",
          "curator": "allow",
          "explore": "allow",
          "general": "allow",
          "scout": "allow"
        }
      }
    },

    // Live 🟩 — Colab variant. Same prompt.txt (symlink), same permission model.
    // Delta: reminders injected LITE-style (only after a real new user message,
    // via prompt-enforcer.js) instead of STRICT-style (every turn, prompt-enforcer-strict.js).
    "Live": {
      "description": "Colab variant — reminders injected only after your real message, not every turn.",
      "mode": "primary",
      "color": "#8BC34A",
      "prompt": "{file:~/.agents/agents/Live/prompt.txt}",
      "permission": {
        "task": {
          "*": "deny",
          "executor": "allow",
          "intent-guardian": "allow",
          "pragmatic-checker": "allow",
          "curator": "allow",
          "explore": "allow",
          "general": "allow",
          "scout": "allow"
        }
      }
    },

    // Explore 🔵 — exploration mode. Inherits global (bash 3-zone, edit ask).
    // Delta: task — which sub-agents Explore can launch.
    "Explore": {
      "model": "opencode-go/mimo-v2.5",
      "description": "Exploration agent — teaches, researches, verifies. Intuitio-formel narrative style for learning.",
      "mode": "primary",
      "color": "#2196F3",
      "prompt": "{file:~/.agents/agents/Explore/prompt.txt}",
      "permission": {
        "task": {
          "*": "deny",
          "fact-verifier": "allow",
          "scout": "allow",
          "explore": "allow",
          "general": "allow"
        }
      }
    },

    // Agent 🟣 — end-to-end solo execution mode. The OPPOSITE of Colab.
    // Built for one thing: take a big task from start to finish, no matter how long.
    // Holds ONLY the objective. Iterates until 100% done. All sub-agents at disposal.
    // Delta: task → ALL sub-agents allowed. tmux send-keys + capture-pane allowed (ops pane).
    "Agent": {
      "description": "End-to-end solo agent — holds only the objective, iterates until fully achieved. All sub-agents at disposal.",
      "mode": "primary",
      "color": "#9C27B0",
      "prompt": "{file:~/.agents/agents/Agent/prompt.txt}",
      "permission": {
        "task": {
          "*": "allow"
        },
        "bash": {
          "tmux send-keys*": "allow",
          "tmux capture-pane*": "allow"
        }
      }
    }
  },

  // ──── Provider — auto-discovered + custom ────
  // ──── Provider — auto-discovered + custom ────
  // ──── Provider — auto-discovered + custom ────
  // ──── Provider — auto-discovered + custom ────
  // ──── Provider — auto-discovered + custom ────
  // ──── Provider — auto-discovered + custom ────
  "provider": {
    "ollama6": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama6",
      "options": {
        "baseURL": "http://localhost:11436/v1"
      },
      "models": {
        "R4C3R/mistral-7b-instruct-v0.3-heretic:q4_k_m": { "name": "R4C3R/mistral-7b-instruct-v0.3-heretic:q4_k_m (4.1 GB — deep-pc6)" },
        "R4C3R/qwen2.5-coder-7b-instruct-heretic:q8_0": { "name": "R4C3R/qwen2.5-coder-7b-instruct-heretic:q8_0 (7.5 GB — deep-pc6)" },
        "R4C3R/qwen3-8b-heretic:q4_k_m": { "name": "R4C3R/qwen3-8b-heretic:q4_k_m (4.7 GB — deep-pc6)" },
        "byczech/glm-4.7-flash-uncensored-16G-AU-IQ3_M:30b": { "name": "byczech/glm-4.7-flash-uncensored-16G-AU-IQ3_M:30b (12.7 GB — deep-pc6)" },
        "gemma3:27b": { "name": "gemma3:27b (16.2 GB — deep-pc6)" },
        "gpt-oss:20b": { "name": "gpt-oss:20b (12.8 GB — deep-pc6)" },
        "jikepjikep_16HEX/gemma-4-26b-nightshift-heretic-uncensored-a4b-moe-q4:latest": { "name": "jikepjikep_16HEX/gemma-4-26b-nightshift-heretic-uncensored-a4b-moe-q4:latest (16.8 GB — deep-pc6)" },
        "ministral-3:8b": { "name": "ministral-3:8b (5.6 GB — deep-pc6)" },
        "mistral-small3.1:24b": { "name": "mistral-small3.1:24b (14.4 GB — deep-pc6)" },
        "mistral-small3.2:24b": { "name": "mistral-small3.2:24b (14.1 GB — deep-pc6)" },
        "mistral-small:24b": { "name": "mistral-small:24b (13.3 GB — deep-pc6)" },
        "mo-shakib/gemma4-e4b-uncensored:q4_k_m": { "name": "mo-shakib/gemma4-e4b-uncensored:q4_k_m (8.9 GB — deep-pc6)" },
        "qwen3-vl:32b": { "name": "qwen3-vl:32b (19.5 GB — deep-pc6)" },
        "qwen3-vl:8b": { "name": "qwen3-vl:8b (5.7 GB — deep-pc6)" },
        "qwen3:30b": { "name": "qwen3:30b (17.3 GB — deep-pc6)" },
        "sorc/qwen3.5-uncensored:9b": { "name": "sorc/qwen3.5-uncensored:9b (8.9 GB — deep-pc6)" },
        "tripolskypetr/qwen3.6-uncensored-aggressive:latest": { "name": "tripolskypetr/qwen3.6-uncensored-aggressive:latest (19.7 GB — deep-pc6)" }
      }
    },
    // Ollama local — auto-synced by opencode-ollama.sh
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "llama3.2:3b": { "name": "llama3.2:3b (1.9 GB local)" },
        "llama3.2:1b": { "name": "llama3.2:1b (1.2 GB local)" },
        "granite4:3b": { "name": "granite4:3b (2.0 GB local)" },
        "granite4:1b": { "name": "granite4:1b (3.0 GB local)" },
        "qwen3:0.6b": { "name": "qwen3:0.6b (0.5 GB local)" },
        "qwen3:4b": { "name": "qwen3:4b (2.3 GB local)" },
        "qwen3:1.7b": { "name": "qwen3:1.7b (1.3 GB local)" }
      }
    },
    "openvino": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenVINO (local)",
      "options": {
        "baseURL": "http://localhost:11437/v1",
        // "litellm" (not "bifrost") is the only format the installed
        // opencode-models-discovery plugin actually maps to `reasoning` —
        // verified by reading the plugin's real installed source
        // (bifrost.ts never reads a reasoning field at all; litellm.ts does:
        // `if (info.supports_reasoning === true) modelConfig.reasoning = true`).
        // Endpoint defaults to /v1/model/info, served dynamically by our own
        // serve.py — no per-model list, ever, in this config.
        "modelsDiscovery": {
          "enabled": true,
          "modelInfoFormat": "litellm"
        }
      }
    },

    // ──── OpenCode Labs Go — 2nd Go account (KπX Labs billing, 2026-09-09) ────
    // Twin of native `opencode-go`. Free models live on Labs Zen (below), not Go.
    // One Labs API key works for BOTH /zen/v1 and /zen/go/v1 — endpoint picks the catalog.
    // Auth id `opencode-labs` (OpenCode stores one key per provider id).
    // Discovery+npm owned by opencode-account-discovery.js (any Nth OpenCode account).
    // Do NOT enable opencode-models-discovery here — race left muse on openai-compatible → 500.
    "opencode-labs": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Labs Go",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "opencodeAccountDiscovery": true
      }
    },
    // ──── OpenCode Labs Zen — same Labs key, Zen endpoint (free + paid Zen) ────
    // muse/luna get per-model provider.npm=@ai-sdk/openai (/v1/responses) via account-discovery.
    "opencode-labs-zen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Labs Zen",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1",
        "opencodeAccountDiscovery": true
      }
    },
    // ──── Cursor — subscription via official SDK (route B, 2026-09-09) ────
    // The @stablekernel/opencode-cursor plugin injects this block automatically ; declared here for explicit control.
    // Auth resolution (plugin default, do NOT pin apiKey explicitly — it kills the stored-credential fallback,
    // fixed 2026-09-09: explicit "{env:CURSOR_API_KEY}" caused "Cursor API key missing" in TUI despite auth.json key):
    // stored `opencode auth login` credential first, CURSOR_API_KEY env fallback, never hardcoded.
    "cursor": {
      "npm": "@stablekernel/opencode-cursor",
      "name": "Cursor"
    },
    // ──── Google AGY — Antigravity CLI OAuth (Google One / AI Pro) via @anthonyhaussman/opencode-agy-auth ────
    // Plugin injects auth + models. npm MUST stay @ai-sdk/google (NOT the auth plugin — that breaks init).
    // Auth: `opencode auth login --provider google-agy` (OAuth, no API key). Optional: options.projectId / OPENCODE_AGY_PROJECT_ID.
    "google-agy": {
      "npm": "@ai-sdk/google",
      "name": "Google AGY"
    },
  },

  "mcp": {
    // Loom → CLI binary only (`loom` in PATH), no MCP
    // See k-loom/SKILL.md for CLI usage; opencode uses bash `loom` commands directly

    // Exa Search MCP → web search via Exa API
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "2ae0e508-3c8f-468f-8870-4446fbb084d2"
      },
      "enabled": true,
      "timeout": 30000
    }
  },

  "watcher": {
    "ignore": [
      "node_modules/**", ".git/**", "**/__pycache__/**",
      ".venv/**", "dist/**", "build/**", ".cursor/**"
    ]
  },

  "plugin": [
    "opencode-dir",
    "opencode-ssh-session",
    "opencode-ast",
    "@anthonyhaussman/opencode-agy-auth@latest", // AGY CLI bridge (Google One) — replaces opencode-antigravity-auth 2026-09-09
    "opencode-models-discovery@latest",
    // AFTER models-discovery: copy per-model provider.npm from models.dev (muse/luna → @ai-sdk/openai)
    // Extra OpenCode accounts (2nd/Nth): GET /models + exact models.dev npm (muse → @ai-sdk/openai)
    "file://{env:HOME}/.agents/skills/k-opencode/scripts/plugins/opencode-account-discovery.js",
    // GitHub Copilot: ignore model_picker_enabled=false for all models (upstream #42083)
    "file://{env:HOME}/.agents/skills/k-opencode/scripts/plugins/opencode-copilot-picker-fix.js",
    "@stablekernel/opencode-cursor@latest", // Cursor subscription via official SDK (route B, 2026-09-09 — key via auth.json or CURSOR_API_KEY)
    // 2026-08-27 (KπX directive): ecosystem plugins — see references/plugin-watch.md for full research
    // @kagan-sh/kagan purged 2026-08-27 (KπX directive) — see references/plugin-watch.md → Purged
    // opencode-notifications purged 2026-08-27 (KπX directive) — replaced by the sovereign opencode-notify.js hook below (always-notify, system + Telegram)
    "opencode-tasks", // Cron scheduler daemon (systemd --user, 60s tick) + /loop in-session loops
    // Runtime hooks — re-enabled 2026-08-09 (KπX directive). Order matters (see k-opencode/SKILL.md).
    // 2026-08-16: hooks moved scripts/hooks → scripts/plugins/hooks (KπX restructure); tmux-notify.js was
    // in scripts/plugins/tmux/, flattened directly into scripts/plugins/ same day (KπX: "plus besoin de
    // dossier tmux, mets ce plugin directement dans plugins") — no more tmux/ subfolder.
    "file://{env:HOME}/.agents/skills/k-opencode/scripts/plugins/hooks/startup-context.js",
    "file://{env:HOME}/.agents/skills/k-opencode/scripts/plugins/hooks/lite-instructions-swap.js",
    "file://{env:HOME}/.agents/skills/k-opencode/scripts/plugins/hooks/prompt-enforcer-lite.js",
    "file://{env:HOME}/.agents/skills/k-opencode/scripts/plugins/hooks/prompt-enforcer.js",
    "file://{env:HOME}/.agents/skills/k-opencode/scripts/plugins/hooks/prompt-enforcer-strict.js",
    "file://{env:HOME}/.agents/skills/k-opencode/scripts/plugins/hooks/stop-enforcer.js",
    "file://{env:HOME}/.agents/skills/k-opencode/scripts/plugins/hooks/make-check-guard.js",
    // git-noverify-guard.js — blocks git commit/push/merge/rebase with --no-verify or -n bypass flags. Same pattern as make-check-guard.js (throw-only, no TARGET_AGENTS).
    "file://{env:HOME}/.agents/skills/k-opencode/scripts/plugins/hooks/git-noverify-guard.js",
    // raw-exec-guard — technically enforces the tmux sudo Gate + no-manual-polling rules (2026-08-29, KπX):
    // blocks raw `sudo`/`sleep`/`wait`/`timeout` outside a compliant `tmux send-keys` call. Same pattern as
    // make-check-guard.js (throw-only, no TARGET_AGENTS — tool.execute.before has no messages to scope by).
    "file://{env:HOME}/.agents/skills/k-opencode/scripts/plugins/hooks/raw-exec-guard.js",
    // humanize-guard — hard PROSE dash gate (2026-09-10, KπX): blocks em-dash (---, —), spaced en-dash ( – ) and markdown -- outside code; code whitelist via libs/humanize/humanize_lib.js (isCodeFile). Same throw-only GLOBAL pattern.
    "file://{env:HOME}/.agents/skills/k-opencode/scripts/plugins/hooks/humanize-guard.js",
    // tmux-notify — relays tmux prompt events (precmd/PROMPT_COMMAND) to the agent (event + chat.message, not messages.transform).
    "file://{env:HOME}/.agents/skills/k-opencode/scripts/plugins/tmux-notify.js",
    // opencode-notify — sovereign always-on system+Telegram notification (session.idle/session.error/permission.ask). NOT a hook (read-only/observational, never influences agent behavior — same category as tmux-notify.js/opencode-context/opencode-voice), lives in its own scripts/plugins/opencode-notify/ subdirectory. Replaces opencode-notifications.
    "file://{env:HOME}/.agents/skills/k-opencode/scripts/plugins/opencode-notify/opencode-notify.js",
    // opencode-help — durable, explicitly parent-controlled root peer sessions. The first ordered model is the default; callers may explicitly choose only another model listed here. Provider/quota failures are transparent: parent archives/reopens with another listed model, never automatic fallback.
    ["file://{env:HOME}/.agents/skills/k-opencode/scripts/plugins/opencode-help/src/index.ts", {
      "models": [
        "opencode-go/mimo-v2.5",
        "opencode-go/deepseek-v4-flash",
        "cursor/composer-2.5"
      ]
    }],
    "file://{env:HOME}/.agents/skills/k-opencode/scripts/plugins/hooks/suggestions-check.js",
    // /context plugin — explicit file:// (1.18.16 auto-discovery glob is non-recursive; explicit path is the reliable mechanism, same as plugins).
    "file://{env:HOME}/.agents/skills/k-opencode/scripts/plugins/opencode-context/context-usage.ts"
  ],

  "compaction": {
    "auto": true,
    "prune": true
  },
  "disabled_providers": [
    "k-ai",
    "ollama6"
  ]
}
