[Unit]
Description=Ollama Vulkan backend (Intel Arc iGPU) — local LLM on port 11435
After=network.target

[Service]
Type=simple
# Bind to a dedicated port so it never collides with the native ollama.service (11434)
Environment=OLLAMA_HOST=127.0.0.1:11435
# Durable model store (NOT ~/.local/ollama-vulkan test dir → zero debris)
Environment=OLLAMA_MODELS=%h/.local/share/ollama-vulkan/models
Environment=OLLAMA_KEEP_ALIVE=10m
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_NUM_PARALLEL=1
# Intel Arc iGPU is NOT auto-enabled by Ollama — must opt in
Environment=OLLAMA_IGPU_ENABLE=1
ExecStart=%h/.local/bin/ollama-vulkan serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
