[Unit]
Description=Rclone mount for Google Drive (kapoivha@gmail.com) at ~/Gdrive
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p /home/kpihx/Gdrive
ExecStart=/usr/bin/rclone mount gdrive: /home/kpihx/Gdrive --config=/home/kpihx/.config/rclone/rclone.conf --vfs-cache-mode full --allow-other --dir-cache-time 1000h --poll-interval 1m --vfs-read-ahead 128M --vfs-cache-max-age 24h --attr-timeout 1000h
ExecStop=/bin/fusermount -uz /home/kpihx/Gdrive
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
