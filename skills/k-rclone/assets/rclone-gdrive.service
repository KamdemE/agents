[Unit]
Description=Rclone mount for Google Drive (<account>@gmail.com) at $HOME/<MountDir>
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p %h/<MountDir>
ExecStart=/usr/bin/rclone mount <remote-name>: %h/<MountDir> \
  --config=%h/.config/rclone/rclone.conf \
  --vfs-cache-mode full \
  --allow-other \
  --dir-cache-time 1m
ExecStop=/bin/fusermount -u %h/<MountDir>
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
