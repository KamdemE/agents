{
  "$schema": "https://opencode.ai/config.json",

  // KπX sovereign wiring — source of truth: $HOME/.agents/skills/k-opencode/SKILL.md
  "autoupdate": "notify",
  "shell": "zsh",
  "model": "opencode-go/qwen3.5-plus",
  "small_model": "opencode-go/deepseek-v4-flash",
  "default_agent": "colab",

  "permission": {
    "edit": "ask",
    "bash": "ask",
    "external_directory": {
      "~/.agents/**": "allow",
      "~/.config/opencode/**": "allow",
      "/tmp/**": "allow",
      "~/Downloads/**": "allow",
      "~/Pictures/**": "allow",
      "~/Gdrive_X/**": "allow",
      "~/Gdrive/**": "allow",
      "~/KpihX-Labs/**": "allow",
      "~/Work/**": "allow"
    },
    "webfetch": "ask",
    "doom_loop": "ask",
    "skill": { "*": "allow" }
  },

  "agent": {
    "build": {
      "permission": {
        "bash": {
          // ──── ALLOW — Zone 1 : read-only purs (zero risque) ────
          "arch": "allow",
          "basename *": "allow",
          "cmp *": "allow",
          "comm *": "allow",
          "cut *": "allow",
          "date *": "allow",
          "diff *": "allow",
          "dirname *": "allow",
          "echo *": "allow",
          "env": "allow",
          "expand *": "allow",
          "file *": "allow",
          "find *": "allow",
          "fmt *": "allow",
          "fold *": "allow",
          "free *": "allow",
          "getconf *": "allow",
          "grep *": "allow",
          "groups *": "allow",
          "head *": "allow",
          "hostname": "allow",
          "id *": "allow",
          "jq *": "allow",
          "join *": "allow",
          "locale *": "allow",
          "logname": "allow",
          "ls*": "allow",
          "man *": "allow",
          "md5sum *": "allow",
          "mktemp *": "allow",
          "more *": "allow",
          "nl *": "allow",
          "nproc": "allow",
          "numfmt *": "allow",
          "paste *": "allow",
          "pr *": "allow",
          "printenv": "allow",
          "printf *": "allow",
          "pwd": "allow",
          "readlink *": "allow",
          "realpath *": "allow",
          "rg *": "allow",
          "seq *": "allow",
          "sha1sum *": "allow",
          "sha256sum *": "allow",
          "sha512sum *": "allow",
          "shuf *": "allow",
          "sort *": "allow",
          "split *": "allow",
          "stat *": "allow",
          "strings *": "allow",
          "tac *": "allow",
          "tail *": "allow",
          "test *": "allow",
          "timedatectl *": "allow",
          "tr *": "allow",
          "tty": "allow",
          "uname *": "allow",
          "unexpand *": "allow",
          "uniq *": "allow",
          "uptime": "allow",
          "users *": "allow",
          "wc *": "allow",
          "whatis *": "allow",
          "whereis *": "allow",
          "which *": "allow",
          "who *": "allow",
          "whoami": "allow",
          // ──── ALLOW — Zone 2 : faible risque (network / navigation) ────
          "command *": "allow",
          "curl *": "allow",
          "df *": "allow",
          "dig *": "allow",
          "du *": "allow",
          "gh *": "allow",
          "glab *": "allow",
          "host *": "allow",
          "nslookup *": "allow",
          "ping *": "allow",
          "sleep *": "allow",
          "ss *": "allow",
          "timeout *": "allow",
          "tmux *": "allow",
          "traceroute *": "allow",
          "tree *": "allow",
          "type *": "allow",
          "w *": "allow",
          "watch *": "allow",
          "wget *": "allow",
          "yes *": "allow",
          // ──── ALLOW — Zone 3 : confiance (dev, file ops non destructeurs) ────
          "alias*": "allow",
          "apropos *": "allow",
          "awk *": "allow",
          "bat *": "allow",
          "bun *": "allow",
          "bzip2 *": "allow",
          "bunzip2 *": "allow",
          "cat *": "allow",
          "cd *": "allow",
          "cp *": "allow",
          "docker *": "allow",
          "git *": "allow",
          "go *": "allow",
          "gzip *": "allow",
          "gunzip *": "allow",
          "iconv *": "allow",
          "ip *": "allow",
          "jupyter *": "allow",
           "less *": "allow",
           "ln *": "allow",
           "lscpu *": "allow",
          "lsof *": "allow",
          "lspci *": "allow",
          "lsusb *": "allow",
          "make *": "allow",
          "mkdir *": "allow",
          "mv *": "allow",
          "node *": "allow",
          "nohup *": "allow",
          "npm *": "allow",
          "npx *": "allow",
          "opencode *": "allow",
          "pgrep *": "allow",
          "pip *": "allow",
          "pip3 *": "allow",
          "pnpm *": "allow",
          "ps *": "allow",
          "python3 *": "allow",
          "rclone *": "allow",
           "rsync *": "allow",
           "ruby *": "allow",
           "scp *": "allow",
          "sftp *": "allow",
          "screen *": "allow",
          "source *": "allow",
          "sqlite3 *": "allow",
          "ssh *": "allow",
          "tailscale *": "allow",
          "tar *": "allow",
          "tee *": "allow",
          "tmux *": "allow",
          "touch *": "allow",
          "unzip *": "allow",
          "uv *": "allow",
          "wget *": "allow",
          "xargs *": "allow",
          "xz *": "allow",
          "unxz *": "allow",
          "yarn *": "allow",
           "zip *": "allow",
           "zsh *": "allow",
           "zstd *": "allow",
          "unzstd *": "allow",
          // ──── ASK — commandes dangereuses (liste explicite) ────
          "rm": "ask",
          "rm *": "ask",
          "rmdir *": "ask",
          "shred *": "ask",
          "sed *": "ask",
          "pkill *": "ask",
          "kill *": "ask",
          "killall *": "ask",
          "sudo *": "ask",
          "chmod *": "ask",
          "chown *": "ask",
          "chattr *": "ask",
          "dd *": "ask",
          "fdisk *": "ask",
          "parted *": "ask",
          "mkfs*": "ask",
          "mount *": "ask",
          "umount *": "ask",
          "systemctl *": "ask",
          "apt *": "ask",
          "apt-get *": "ask",
          "dpkg *": "ask",
          "snap *": "ask",
          "flatpak *": "ask",
          "passwd *": "ask",
          "useradd *": "ask",
          "usermod *": "ask",
          "userdel *": "ask",
          "groupadd *": "ask",
          "groupmod *": "ask",
          "groupdel *": "ask",
          "shutdown *": "ask",
          "reboot *": "ask",
          "halt *": "ask",
          "poweroff *": "ask",
          "init *": "ask",
          "crontab *": "ask",
          "update-alternatives *": "ask"
        }
      }
    },
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "rg *": "allow"
        }
      }
    },
    "colab": {
      "description": "Exploitation — build projects, architecture, tools. Mini-plans, questions when ambiguous. Sub-agents: intent-guardian, executor, pragmatic-checker.",
      "mode": "primary",
      "color": "#4CAF50",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": {
          "*": "deny",
          "intent-guardian": "allow",
          "executor": "allow",
          "pragmatic-checker": "allow",
          "explore": "allow",
          "general": "allow"
        }
      }
    },
    "explore": {
      "description": "Exploration — learning, discovery, training. TEACH FIRST: explain concepts intuitively, never search files blindly. Sub-agents: main-teacher, style-guardian, fact-verifier.",
      "prompt": "You are in EXPLORE mode. You are a TEACHER, not a file searcher. When KπX asks to understand a concept: EXPLAIN it directly from your knowledge. Do NOT run rg, grep, glob, or find as a first reflex. Teach first. Use web search only to verify facts. Read profiles/explore/AGENTS.md for your full teaching contract.",
      "mode": "primary",
      "color": "#2196F3",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "deny",
          "uv run *": "allow",
          "rg *": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "echo *": "allow"
        },
        "task": {
          "*": "deny",
          "main-teacher": "allow",
          "style-guardian": "allow",
          "fact-verifier": "allow",
          "explore": "allow",
          "general": "allow",
          "scout": "allow"
        }
      }
    }
  },

  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "oauth": false,
      "enabled": true
    },
    "mail_fallback": {
      "type": "local",
      "command": ["zsh", "-l", "-c", "/home/kpihx/.local/bin/mail-mcp serve"],
      "enabled": true,
      "timeout": 60000
    },
    "tick_fallback": {
      "type": "local",
      "command": ["zsh", "-l", "-c", "/home/kpihx/.local/bin/tick-mcp serve"],
      "enabled": true,
      "timeout": 60000
    },
    // Browser MCP → 10% (CAPTCHA/2FA/formulaires spéciaux)
    "browser": {
      "type": "local",
      "command": ["zsh", "-l", "-c", "browser-mcp"],
      "enabled": true,
      "timeout": 60000
    },
    // Chrome Agent MCP → 90% (navigation, tabs, devtools, contenu)
    "chrome-agent": {
      "type": "local",
      "command": ["zsh", "-l", "-c", "chrome-agent-mcp"],
      "enabled": true,
      "timeout": 60000
    }
  },

  "watcher": {
    "ignore": [
      "node_modules/**", ".git/**", "**/__pycache__/**",
      ".venv/**", "dist/**", "build/**", ".cursor/**"
    ]
  },

  "plugin": ["opencode-dir", "opencode-ssh-session", "file:~/.config/opencode/plugins/kpihx-orchestra"],

  "compaction": { "auto": true, "prune": true }
}
